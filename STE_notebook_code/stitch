st.set_page_config(page_title="SEM Mosaic Builder (IC Explorer Aware)", layout="wide")
st.title("SEM Mosaic Builder with World-Coordinate Alignment (IC Explorer Aware)")

uploaded_images = st.file_uploader("Upload grayscale SEM images", accept_multiple_files=True)

coord_mode = st.radio("Coordinate Input Mode", ["Manual Entry", "Upload CSV"], horizontal=True)

coords_df = None
if uploaded_images:
    image_names = [f.name for f in uploaded_images]

    if coord_mode == "Manual Entry":
        st.markdown("### Enter Coordinates for Each Image")
        rows = []
        for i, name in enumerate(image_names):
            with st.expander(f"{name}", expanded=(i == 0)):
                x0 = st.number_input(f"x0_{i}", value=0.0, step=1.0)
                y0 = st.number_input(f"y0_{i}", value=0.0, step=1.0)
                x1 = st.number_input(f"x1_{i}", value=512.0, step=1.0)
                y1 = st.number_input(f"y1_{i}", value=512.0, step=1.0)
                rows.append({"filename": name, "x0": x0, "y0": y0, "x1": x1, "y1": y1})
        coords_df = pd.DataFrame(rows)
    else:
        uploaded_csv = st.file_uploader("Upload CSV with coordinates", type="csv")
        if uploaded_csv:
            tmp = pd.read_csv(uploaded_csv)
            required = {'filename', 'x0', 'y0', 'x1', 'y1'}
            if not required.issubset(tmp.columns):
                st.error("CSV must contain columns: filename, x0, y0, x1, y1")
                st.stop()
            coords_df = tmp.copy()

if coords_df is not None and len(coords_df) > 0:
    st.markdown("### Alignment Parameters")

    # Y-axis direction
    y_mode_choice = st.radio(
        "Y axis direction",
        ["Auto-detect (IC Explorer likely)", "Down decreases (IC Explorer)", "Down increases (Image default)"],
        index=1,  # default to IC Explorer
        help=(
            "IC Explorer uses a coordinate system where Y decreases as you go down. "
            "Image pixel coordinates increase Y downward."
        )
    )

    if y_mode_choice.startswith("Auto"):
        y_mode = y_mode_autodetect(coords_df)
        st.caption(f"Auto-detected Y mode: **{'IC Explorer (down decreases)' if y_mode == 'ic' else 'Image (down increases)'}**")
    elif y_mode_choice.startswith("Down decreases"):
        y_mode = 'ic'
    else:
        y_mode = 'image'

    # Snapping (row/column normalization)
    with st.expander("Row/Column Snapping (normalize to align)", expanded=False):
        snap_rows = st.checkbox("Snap Rows (align Y tops)", value=False)
        snap_cols = st.checkbox("Snap Columns (align X lefts)", value=False)
        snap_tol = st.number_input(
            "Snap tolerance (world units)",
            min_value=0.0, value=2.0, step=0.5,
            help="Values within this world-unit tolerance collapse to a shared line."
        )
        if snap_rows or snap_cols:
            coords_snapped = apply_snapping(coords_df, y_mode=y_mode, snap_rows=snap_rows, snap_cols=snap_cols, tol=snap_tol)
        else:
            coords_snapped = coords_df.copy()
    coords_to_use = coords_snapped

    # Scaling options
    with st.expander("Scaling (world units vs pixels)", expanded=False):
        assume_one_to_one = st.checkbox("Assume 1 world unit == 1 pixel", value=True)
        if not assume_one_to_one:
            images_map = decode_images(uploaded_images)
            wpp_x, wpp_y, used = compute_world_per_pixel_scales(images_map, coords_to_use)
            st.caption(f"Estimated world-per-pixel (median) from {used} tiles: "
                       f"wpp_x={wpp_x:.6g}, wpp_y={wpp_y:.6g}")
            # Allow override
            world_per_pixel_x = st.number_input("World units per pixel (X)", value=float(wpp_x), min_value=1e-9, step=1e-6, format="%.9f")
            world_per_pixel_y = st.number_input("World units per pixel (Y)", value=float(wpp_y), min_value=1e-9, step=1e-6, format="%.9f")
        else:
            world_per_pixel_x, world_per_pixel_y = 1.0, 1.0

    st.markdown("### Output")
    write_png = st.checkbox("Save PNG", value=True)
    write_tiff = st.checkbox("Save BigTIFF", value=False)
    base_name = st.text_input("Base Name", value="mosaic")
    output_dir = st.text_input("Output Directory", value="output")

    if st.button("Merge Images", type="primary", use_container_width=False):
        os.makedirs(output_dir, exist_ok=True)

        images = decode_images(uploaded_images)

        try:
            canvas, preview, placements, meta = merge_images(
                images=images,
                coords=coords_to_use,
                y_mode=y_mode,
                assume_one_to_one=assume_one_to_one,
                world_per_pixel_x=world_per_pixel_x,
                world_per_pixel_y=world_per_pixel_y,
                clip_out_of_bounds=True,
            )
        except Exception as e:
            st.error(f"Failed to merge: {e}")
            st.stop()

        saved_paths = []

        # Save outputs
        if write_png:
            png_path = os.path.join(output_dir, f"{base_name}.png")
            try:
                cv2.imwrite(png_path, canvas)
                saved_paths.append(png_path)
            except Exception as e:
                st.warning(f"Failed to write PNG: {e}")

        if write_tiff:
            try:
                import tifffile
                tiff_path = os.path.join(output_dir, f"{base_name}.tif")
                # Use tiling to avoid huge single-strip TIFFs
                tifffile.imwrite(tiff_path, canvas, bigtiff=True, tile=(512, 512), compression="zlib")
                saved_paths.append(tiff_path)
            except Exception as e:
                st.warning(f"Failed to write BigTIFF: {e}")

        meta_path = os.path.join(output_dir, f"{base_name}_meta.json")
        try:
            with open(meta_path, "w") as f:
                json.dump(convert_to_native(meta), f, indent=2)
            saved_paths.append(meta_path)
        except Exception as e:
            st.warning(f"Failed to write metadata JSON: {e}")

        csv_path = os.path.join(output_dir, f"{base_name}_placements.csv")
        try:
            pd.DataFrame(placements).to_csv(csv_path, index=False)
            saved_paths.append(csv_path)
        except Exception as e:
            st.warning(f"Failed to write placements CSV: {e}")

        st.success("Mosaic created and saved.")
        for p in saved_paths:
            st.write(f"Saved: `{p}`")

        st.image(preview, caption="Preview (downsampled)", clamp=True, channels="GRAY")
        st.json(meta)

else:
    st.info("Upload images to begin.")

