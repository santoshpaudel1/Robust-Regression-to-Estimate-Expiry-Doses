import io, math, json
from pathlib import Path
import numpy as np
import pandas as pd
import streamlit as st
import cv2

# --------------- Enhanced Helpers for Gap Handling ---------------
def read_png_bytes(file):
    data = np.frombuffer(file.read(), np.uint8)
    img = cv2.imdecode(data, cv2.IMREAD_UNCHANGED)
    if img is None:
        raise ValueError(f"Cannot read PNG: {getattr(file, 'name', 'uploaded file')}")
    return img

def to_gray(img):
    if img.ndim == 3:
        if img.shape[2] == 4:
            img = cv2.cvtColor(img, cv2.COLOR_BGRA2BGR)
        return cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    return img

def hann2d(shape):
    h, w = shape
    wy = np.hanning(h)
    wx = np.hanning(w)
    return np.outer(wy, wx).astype(np.float32)

def enhanced_phase_corr(ref_strip, mov_strip, max_shift=100):
    """Enhanced phase correlation with validation"""
    try:
        # Ensure strips are the same size
        if ref_strip.shape != mov_strip.shape:
            mov_strip = cv2.resize(mov_strip, (ref_strip.shape[1], ref_strip.shape[0]))
            
        win = hann2d(ref_strip.shape)
        r = ref_strip.astype(np.float32) * win
        m = mov_strip.astype(np.float32) * win
        
        (shifty, shiftx), response = cv2.phaseCorrelate(r, m)
        
        # Validate correlation quality
        if response < 0.05:  # Lower threshold for challenging cases
            return 0.0, 0.0, False, response
            
        # Check if shift is reasonable
        if abs(shiftx) > max_shift or abs(shifty) > max_shift:
            return 0.0, 0.0, False, response
            
        return float(shiftx), float(shifty), True, response
        
    except Exception as e:
        return 0.0, 0.0, False, 0.0

def detect_gap_from_coordinates(tile1, tile2, direction='horizontal', bbox_inclusive=False):
    """Detect if there's a gap between tiles based on coordinates"""
    if direction == 'horizontal':
        # For left-right neighbors
        if bbox_inclusive:
            gap = tile1["x1"] - tile2["x2"] - 1
        else:
            gap = tile1["x1"] - tile2["x2"]
    else:  # vertical
        if bbox_inclusive:
            gap = tile1["y1"] - tile2["y2"] - 1
        else:
            gap = tile1["y1"] - tile2["y2"]
    
    return gap

def estimate_gap_from_visual(canvas, current_tile, neighbor, direction, analysis_width=100):
    """Try to estimate gap size from visual content"""
    try:
        if direction == 'horizontal':
            # Look for content edges near the expected boundary
            neighbor_right_edge = neighbor["tlx"] + neighbor["w"]
            current_left_edge = current_tile["tlx"]
            
            # Extract strips from both sides of the potential gap
            strip_height = min(neighbor["h"], current_tile["h"], 100)
            neighbor_strip = canvas[neighbor["tly"]:neighbor["tly"]+strip_height, 
                                   neighbor_right_edge-analysis_width:neighbor_right_edge]
            current_strip = canvas[current_tile["tly"]:current_tile["tly"]+strip_height,
                                 current_left_edge:current_left_edge+analysis_width]
            
            # Simple edge detection to find content boundaries
            neighbor_edges = cv2.Canny(neighbor_strip, 50, 150)
            current_edges = cv2.Canny(current_strip, 50, 150)
            
            # Find the rightmost edge in neighbor and leftmost in current
            neighbor_edge_pos = np.max(np.where(neighbor_edges > 0)[1]) if np.any(neighbor_edges) else 0
            current_edge_pos = np.min(np.where(current_edges > 0)[1]) if np.any(current_edges) else analysis_width
            
            estimated_gap = (analysis_width - neighbor_edge_pos) + current_edge_pos
            return estimated_gap
            
    except Exception:
        pass
    
    return None

def feather_blend(canvas, tile, x, y, ksize=51):
    H, W = canvas.shape[:2]
    h, w = tile.shape[:2]
    x0, y0 = max(0, x), max(0, y)
    x1, y1 = min(W, x + w), min(H, y + h)
    if x0 >= x1 or y0 >= y1:
        return
    c = canvas[y0:y1, x0:x1]
    t = tile[y0 - y : y0 - y + (y1 - y0), x0 - x : x0 - x + (x1 - x0)]
    mask = (t > 0).astype(np.float32)
    if ksize % 2 == 0: ksize += 1
    if ksize > 1:
        mask = cv2.GaussianBlur(mask, (ksize, ksize), 0)
    c[:] = (c.astype(np.float32)*(1-mask) + t.astype(np.float32)*mask).astype(canvas.dtype)

def place_with_gap_fill(canvas, tile, x, y, gap_info=None, mode="feather", feather_ksize=51):
    """Place tile with optional gap filling"""
    if mode == "feather":
        feather_blend(canvas, tile, x, y, feather_ksize)
    else:
        H, W = canvas.shape[:2]
        h, w = tile.shape[:2]
        x0, y0 = max(0, x), max(0, y)
        x1, y1 = min(W, x + w), min(H, y + h)
        if x0 >= x1 or y0 >= y1: return
        c = canvas[y0:y1, x0:x1]
        t = tile[y0 - y : y0 - y + (y1 - y0), x0 - x : x0 - x + (x1 - x0)]
        if mode == "overwrite":
            c[:] = t
        elif mode == "average":
            c[:] = ((c.astype(np.float32)+t.astype(np.float32))/2).astype(c.dtype)

def estimate_scale(df, images_by_name, bbox_inclusive):
    sx_list, sy_list = [], []
    for _, r in df.iterrows():
        name = str(r["filename"])
        if name not in images_by_name: continue
        img = images_by_name[name]["img"]
        h, w = img.shape[:2]
        dx = float(r["x2"]) - float(r["x1"]) + (1 if bbox_inclusive else 0)
        dy = float(r["y2"]) - float(r["y1"]) + (1 if bbox_inclusive else 0)
        if dx <= 0 or dy <= 0: continue
        sx_list.append(w / dx)
        sy_list.append(h / dy)
    if not sx_list or not sy_list:
        raise RuntimeError("Could not estimate pixels-per-unit — check CSV/images.")
    return float(np.median(sx_list)), float(np.median(sy_list))

def build_mosaic_with_gap_handling(
    df, images_by_name,
    ic_y_is_up=True,
    bbox_inclusive=False,
    pixels_per_unit_x=None,
    pixels_per_unit_y=None,
    refine_overlap_px=50,
    blend_mode="feather",
    feather_ksize=51,
    output_color=False,
    alignment_method="auto",
    gap_handling="warn",  # "warn", "estimate", or "ignore"
    progress_cb=None
):
    # Validate numeric
    df = df.copy()
    for col in ["x1","y1","x2","y2"]:
        df[col] = pd.to_numeric(df[col], errors="coerce")
    if df[["x1","y1","x2","y2"]].isnull().any().any():
        raise ValueError("CSV contains non-numeric coordinates.")

    # Load tiles
    tiles = []
    for _, r in df.iterrows():
        name = str(r["filename"])
        if name not in images_by_name:
            raise FileNotFoundError(f"Missing image: {name}")
        raw = images_by_name[name]["img"]
        img = raw.copy()
        if output_color:
            if img.ndim == 2:
                img = cv2.cvtColor(img, cv2.COLOR_GRAY2BGR)
            elif img.shape[2] == 4:
                img = cv2.cvtColor(img, cv2.COLOR_BGRA2BGR)
        else:
            img = to_gray(img)
        h, w = img.shape[:2]
        x1, y1, x2, y2 = map(float, [r["x1"], r["y1"], r["x2"], r["y2"]])
        dx = x2 - x1 + (1 if bbox_inclusive else 0)
        dy = y2 - y1 + (1 if bbox_inclusive else 0)
        tiles.append(dict(filename=name, img=img, h=h, w=w, x1=x1, y1=y1, x2=x2, y2=y2, dx=dx, dy=dy))

    # Scale
    if pixels_per_unit_x is None or pixels_per_unit_y is None:
        sx, sy = estimate_scale(df, images_by_name, bbox_inclusive)
    else:
        sx, sy = float(pixels_per_unit_x), float(pixels_per_unit_y)

    # Extents (stage units)
    xs, ys = [], []
    for t in tiles:
        xs += [t["x1"], t["x2"]]
        ys += [t["y1"], t["y2"]]
    xmin, xmax = min(xs), max(xs)
    ymin, ymax = min(ys), max(ys)

    # Map top-left to canvas pixels
    for t in tiles:
        if ic_y_is_up:
            tly = (ymax - t["y1"]) * sy
        else:
            tly = (t["y1"] - ymin) * sy
        tlx = (t["x1"] - xmin) * sx
        t["tlx"], t["tly"] = int(round(tlx)), int(round(tly))

    # Canvas - add extra padding for potential gap filling
    canvas_W = int(math.ceil((xmax - xmin) * sx)) + 100  # Extra padding
    canvas_H = int(math.ceil((ymax - ymin) * sy)) + 100  # Extra padding
    if output_color:
        canvas = np.zeros((canvas_H, canvas_W, 3), dtype=np.uint8)
    else:
        canvas = np.zeros((canvas_H, canvas_W), dtype=np.uint8)

    # Sort & place
    tiles_sorted = sorted(tiles, key=lambda t: (t["tly"], t["tlx"]))
    transforms = {}
    gap_report = []

    # Enhanced neighbor search
    def left_neighbor(t):
        cands = [u for u in tiles_sorted if u is not t 
                 and abs(u["tly"]-t["tly"]) < max(refine_overlap_px * 3, 150)
                 and u["tlx"] < t["tlx"]]
        return max(cands, key=lambda u: u["tlx"]) if cands else None

    def top_neighbor(t):
        cands = [u for u in tiles_sorted if u is not t 
                 and abs(u["tlx"]-t["tlx"]) < max(refine_overlap_px * 3, 150)
                 and u["tly"] < t["tly"]]
        return max(cands, key=lambda u: u["tly"]) if cands else None

    # First tile
    t0 = tiles_sorted[0]
    place_with_gap_fill(canvas, t0["img"], t0["tlx"], t0["tly"], mode=blend_mode, feather_ksize=feather_ksize)
    transforms[t0["filename"]] = {"dx":0.0, "dy":0.0, "tlx":t0["tlx"], "tly":t0["tly"], "method": "initial"}

    # Enhanced placement with gap detection
    for i, t in enumerate(tiles_sorted[1:], start=2):
        img = t["img"]
        x_coarse, y_coarse = t["tlx"], t["tly"]
        dx_total = dy_total = 0.0
        used = 0
        methods_used = []
        gap_detected = False

        if refine_overlap_px and refine_overlap_px > 0:
            max_shift = refine_overlap_px * 2

            # Left neighbor alignment with gap detection
            L = left_neighbor(t)
            if L is not None:
                # Check for gap from coordinates
                coord_gap = detect_gap_from_coordinates(t, L, 'horizontal', bbox_inclusive)
                gap_pixels = coord_gap * sx if coord_gap > 0 else 0
                
                if gap_pixels > 10:  # Significant gap detected
                    gap_detected = True
                    gap_report.append({
                        "tile1": L["filename"],
                        "tile2": t["filename"],
                        "gap_pixels": gap_pixels,
                        "direction": "horizontal",
                        "coord_gap": coord_gap
                    })
                    
                    if gap_handling == "estimate":
                        # Try to estimate gap from visual content
                        visual_gap = estimate_gap_from_visual(canvas, t, L, 'horizontal')
                        if visual_gap is not None and visual_gap < gap_pixels:
                            # Adjust position based on visual estimation
                            dx_total -= (gap_pixels - visual_gap)
                            used += 1
                            methods_used.append("gap_estimation")
                else:
                    # Normal overlap case - try alignment methods
                    analysis_width = min(max(refine_overlap_px * 2, 60), img.shape[1] // 3, L["w"] // 3)
                    analysis_height = min(img.shape[0], L["h"])
                    
                    mov_strip = to_gray(img[:, :analysis_width]) if img.ndim==3 else img[:, :analysis_width]
                    
                    xL, yL = L["tlx"], L["tly"]
                    ref_x0 = xL + L["w"] - analysis_width
                    ref_y0 = max(0, min(y_coarse, canvas_H - analysis_height))
                    ref_x1 = ref_x0 + analysis_width
                    ref_y1 = ref_y0 + analysis_height
                    
                    if (0 <= ref_x0 < ref_x1 <= canvas_W and 
                        0 <= ref_y0 < ref_y1 <= canvas_H and
                        ref_y1 - ref_y0 == mov_strip.shape[0]):
                        
                        ref_strip = canvas[ref_y0:ref_y1, ref_x0:ref_x1]
                        ref_strip = to_gray(ref_strip) if ref_strip.ndim==3 else ref_strip
                        
                        if ref_strip.size > 0 and mov_strip.size > 0:
                            success = False
                            sxp, syp = 0.0, 0.0
                            method_used = "none"
                            response = 0.0
                            
                            if alignment_method in ["auto", "phase_correlation"]:
                                sxp, syp, success, response = enhanced_phase_corr(ref_strip, mov_strip, max_shift)
                                if success:
                                    method_used = f"phase_correlation (r:{response:.3f})"
                            
                            if not success and alignment_method in ["auto", "feature_based"]:
                                # Skip feature-based for very low response
                                if response > 0.02:  
                                    try:
                                        # Fallback to simple template matching for difficult cases
                                        result = cv2.matchTemplate(ref_strip, mov_strip, cv2.TM_CCOEFF_NORMED)
                                        _, max_val, _, max_loc = cv2.minMaxLoc(result)
                                        if max_val > 0.3:  # Reasonable match
                                            sxp = max_loc[0] - (mov_strip.shape[1] // 2)
                                            syp = max_loc[1] - (mov_strip.shape[0] // 2)
                                            success = True
                                            method_used = f"template_match (r:{max_val:.3f})"
                                    except:
                                        pass
                            
                            if success:
                                dx_total += sxp
                                dy_total += syp
                                used += 1
                                methods_used.append(method_used)

            # Similar enhanced logic for top neighbor...
            Tn = top_neighbor(t)
            if Tn is not None:
                coord_gap = detect_gap_from_coordinates(t, Tn, 'vertical', bbox_inclusive)
                gap_pixels = coord_gap * sy if coord_gap > 0 else 0
                
                if gap_pixels > 10:
                    gap_detected = True
                    gap_report.append({
                        "tile1": Tn["filename"],
                        "tile2": t["filename"],
                        "gap_pixels": gap_pixels,
                        "direction": "vertical",
                        "coord_gap": coord_gap
                    })
                else:
                    # Normal overlap case for top neighbor (similar to left neighbor)
                    analysis_height = min(max(refine_overlap_px * 2, 60), img.shape[0] // 3, Tn["h"] // 3)
                    analysis_width = min(img.shape[1], Tn["w"])
                    
                    mov_strip = to_gray(img[:analysis_height, :]) if img.ndim==3 else img[:analysis_height, :]
                    
                    xT, yT = Tn["tlx"], Tn["tly"]
                    ref_x0 = max(0, min(x_coarse, canvas_W - analysis_width))
                    ref_y0 = yT + Tn["h"] - analysis_height
                    ref_x1 = ref_x0 + analysis_width
                    ref_y1 = ref_y0 + analysis_height
                    
                    if (0 <= ref_x0 < ref_x1 <= canvas_W and 
                        0 <= ref_y0 < ref_y1 <= canvas_H and
                        ref_x1 - ref_x0 == mov_strip.shape[1]):
                        
                        ref_strip = canvas[ref_y0:ref_y1, ref_x0:ref_x1]
                        ref_strip = to_gray(ref_strip) if ref_strip.ndim==3 else ref_strip
                        
                        if ref_strip.size > 0 and mov_strip.size > 0:
                            success = False
                            sxp, syp = 0.0, 0.0
                            method_used = "none"
                            response = 0.0
                            
                            if alignment_method in ["auto", "phase_correlation"]:
                                sxp, syp, success, response = enhanced_phase_corr(ref_strip, mov_strip, max_shift)
                                if success:
                                    method_used = f"phase_correlation (r:{response:.3f})"
                            
                            if not success and response > 0.02:
                                try:
                                    result = cv2.matchTemplate(ref_strip, mov_strip, cv2.TM_CCOEFF_NORMED)
                                    _, max_val, _, max_loc = cv2.minMaxLoc(result)
                                    if max_val > 0.3:
                                        sxp = max_loc[0] - (mov_strip.shape[1] // 2)
                                        syp = max_loc[1] - (mov_strip.shape[0] // 2)
                                        success = True
                                        method_used = f"template_match (r:{max_val:.3f})"
                                except:
                                    pass
                            
                            if success:
                                dx_total += sxp
                                dy_total += syp
                                used += 1
                                methods_used.append(method_used)

        # Apply final adjustment
        dx = dx_total / used if used else 0.0
        dy = dy_total / used if used else 0.0
        
        x_final = int(round(x_coarse + dx))
        y_final = int(round(y_coarse + dy))
        
        place_with_gap_fill(canvas, img, x_final, y_final, mode=blend_mode, feather_ksize=feather_ksize)
        
        transforms[t["filename"]] = {
            "dx": float(dx), 
            "dy": float(dy), 
            "tlx": x_final, 
            "tly": y_final,
            "methods_used": methods_used if methods_used else ["coords_only"],
            "gap_detected": gap_detected
        }

        if progress_cb:
            progress_cb(i, len(tiles_sorted))

    # Crop canvas back to actual content
    non_zero_coords = np.where(canvas > 0)
    if len(non_zero_coords[0]) > 0:
        min_y, max_y = np.min(non_zero_coords[0]), np.max(non_zero_coords[0])
        min_x, max_x = np.min(non_zero_coords[1]), np.max(non_zero_coords[1])
        canvas = canvas[min_y:max_y+1, min_x:max_x+1]
        
        # Update tile positions relative to cropped canvas
        for tile_info in transforms.values():
            tile_info["tlx"] -= min_x
            tile_info["tly"] -= min_y

    report = {
        "ic_y_is_up": ic_y_is_up,
        "bbox_inclusive": bbox_inclusive,
        "pixels_per_unit_x": sx,
        "pixels_per_unit_y": sy,
        "refine_overlap_px": refine_overlap_px,
        "blend_mode": blend_mode,
        "alignment_method": alignment_method,
        "gap_handling": gap_handling,
        "gaps_detected": gap_report,
        "tiles": transforms
    }
    return canvas, report

def encode_png(img):
    if img.dtype != np.uint8:
        img = np.clip(img, 0, 255).astype(np.uint8)
    ok, buf = cv2.imencode(".png", img)
    return buf.tobytes() if ok else None

