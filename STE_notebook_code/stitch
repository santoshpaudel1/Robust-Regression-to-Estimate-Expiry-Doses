# app.py  (PNG-only IC tile stitcher)
import io, math, json
from pathlib import Path
import numpy as np
import pandas as pd
import streamlit as st
import cv2

# --------------- Helpers ---------------
def read_png_bytes(file):
    data = np.frombuffer(file.read(), np.uint8)
    img = cv2.imdecode(data, cv2.IMREAD_UNCHANGED)  # supports grayscale/RGB/alpha
    if img is None:
        raise ValueError(f"Cannot read PNG: {getattr(file, 'name', 'uploaded file')}")
    # Normalize to grayscale or BGR (we’ll output grayscale unless toggled)
    return img

def to_gray(img):
    if img.ndim == 3:
        # if BGRA or RGBA → convert to BGR first
        if img.shape[2] == 4:
            img = cv2.cvtColor(img, cv2.COLOR_BGRA2BGR)
        return cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    return img

def hann2d(shape):
    h, w = shape
    wy = np.hanning(h)
    wx = np.hanning(w)
    return np.outer(wy, wx).astype(np.float32)

def phase_corr(ref_strip, mov_strip):
    win = hann2d(ref_strip.shape)
    r = ref_strip.astype(np.float32) * win
    m = mov_strip.astype(np.float32) * win
    (shifty, shiftx), _ = cv2.phaseCorrelate(r, m)  # (dy, dx)
    return float(shiftx), float(shifty)

def feather_blend(canvas, tile, x, y, ksize=31):
    H, W = canvas.shape[:2]
    h, w = tile.shape[:2]
    x0, y0 = max(0, x), max(0, y)
    x1, y1 = min(W, x + w), min(H, y + h)
    if x0 >= x1 or y0 >= y1:
        return
    c = canvas[y0:y1, x0:x1]
    t = tile[y0 - y : y0 - y + (y1 - y0), x0 - x : x0 - x + (x1 - x0)]
    mask = (t > 0).astype(np.float32)
    if ksize % 2 == 0: ksize += 1
    if ksize > 1:
        mask = cv2.GaussianBlur(mask, (ksize, ksize), 0)
    c[:] = (c.astype(np.float32)*(1-mask) + t.astype(np.float32)*mask).astype(canvas.dtype)

def place(canvas, tile, x, y, mode="feather", feather_ksize=31):
    if mode == "feather":
        feather_blend(canvas, tile, x, y, feather_ksize)
        return
    H, W = canvas.shape[:2]
    h, w = tile.shape[:2]
    x0, y0 = max(0, x), max(0, y)
    x1, y1 = min(W, x + w), min(H, y + h)
    if x0 >= x1 or y0 >= y1: return
    c = canvas[y0:y1, x0:x1]
    t = tile[y0 - y : y0 - y + (y1 - y0), x0 - x : x0 - x + (x1 - x0)]
    if mode == "overwrite":
        c[:] = t
    elif mode == "average":
        c[:] = ((c.astype(np.float32)+t.astype(np.float32))/2).astype(canvas.dtype)
    else:
        raise ValueError("Unknown blend mode")

def estimate_scale(df, images_by_name, bbox_inclusive):
    sx_list, sy_list = [], []
    for _, r in df.iterrows():
        name = str(r["filename"])
        if name not in images_by_name: continue
        img = images_by_name[name]["img"]
        h, w = img.shape[:2]
        dx = float(r["x2"]) - float(r["x1"]) + (1 if bbox_inclusive else 0)
        dy = float(r["y2"]) - float(r["y1"]) + (1 if bbox_inclusive else 0)
        if dx <= 0 or dy <= 0: continue
        sx_list.append(w / dx)
        sy_list.append(h / dy)
    if not sx_list or not sy_list:
        raise RuntimeError("Could not estimate pixels-per-unit — check CSV/images.")
    return float(np.median(sx_list)), float(np.median(sy_list))

def build_mosaic(
    df, images_by_name,
    ic_y_is_up=True,
    bbox_inclusive=False,
    pixels_per_unit_x=None,
    pixels_per_unit_y=None,
    refine_overlap_px=8,
    blend_mode="feather",
    feather_ksize=31,
    output_color=False,
    progress_cb=None
):
    # Validate numeric
    df = df.copy()
    for col in ["x1","y1","x2","y2"]:
        df[col] = pd.to_numeric(df[col], errors="coerce")
    if df[["x1","y1","x2","y2"]].isnull().any().any():
        raise ValueError("CSV contains non-numeric coordinates.")

    # Load tiles
    tiles = []
    for _, r in df.iterrows():
        name = str(r["filename"])
        if name not in images_by_name:
            raise FileNotFoundError(f"Missing image: {name}")
        raw = images_by_name[name]["img"]
        img = raw.copy()
        if output_color:
            # ensure 3-channel BGR
            if img.ndim == 2:
                img = cv2.cvtColor(img, cv2.COLOR_GRAY2BGR)
            elif img.shape[2] == 4:
                img = cv2.cvtColor(img, cv2.COLOR_BGRA2BGR)
        else:
            img = to_gray(img)
        h, w = img.shape[:2]
        x1, y1, x2, y2 = map(float, [r["x1"], r["y1"], r["x2"], r["y2"]])
        dx = x2 - x1 + (1 if bbox_inclusive else 0)
        dy = y2 - y1 + (1 if bbox_inclusive else 0)
        tiles.append(dict(filename=name, img=img, h=h, w=w, x1=x1, y1=y1, x2=x2, y2=y2, dx=dx, dy=dy))

    # Scale
    if pixels_per_unit_x is None or pixels_per_unit_y is None:
        sx, sy = estimate_scale(df, images_by_name, bbox_inclusive)
    else:
        sx, sy = float(pixels_per_unit_x), float(pixels_per_unit_y)

    # Extents (stage units)
    xs, ys = [], []
    for t in tiles:
        xs += [t["x1"], t["x2"]]
        ys += [t["y1"], t["y2"]]
    xmin, xmax = min(xs), max(xs)
    ymin, ymax = min(ys), max(ys)

    # Map top-left to canvas pixels
    for t in tiles:
        if ic_y_is_up:
            tly = (ymax - t["y1"]) * sy
        else:
            tly = (t["y1"] - ymin) * sy
        tlx = (t["x1"] - xmin) * sx
        t["tlx"], t["tly"] = int(round(tlx)), int(round(tly))

    # Canvas
    canvas_W = int(math.ceil((xmax - xmin) * sx))
    canvas_H = int(math.ceil((ymax - ymin) * sy))
    if output_color:
        canvas = np.zeros((canvas_H, canvas_W, 3), dtype=np.uint8)
    else:
        canvas = np.zeros((canvas_H, canvas_W), dtype=np.uint8)

    # Sort & place
    tiles_sorted = sorted(tiles, key=lambda t: (t["tly"], t["tlx"]))
    transforms = {}

    # First tile
    t0 = tiles_sorted[0]
    place(canvas, t0["img"], t0["tlx"], t0["tly"], mode=blend_mode, feather_ksize=feather_ksize)
    transforms[t0["filename"]] = {"dx":0.0, "dy":0.0, "tlx":t0["tlx"], "tly":t0["tly"]}

    # Neighbor search
    def left_neighbor(t):
        cands = [u for u in tiles_sorted if u is not t and abs(u["tly"]-t["tly"]) < max(refine_overlap_px*4, 32) and u["tlx"] < t["tlx"]]
        return max(cands, key=lambda u: u["tlx"]) if cands else None

    def top_neighbor(t):
        cands = [u for u in tiles_sorted if u is not t and abs(u["tlx"]-t["tlx"]) < max(refine_overlap_px*4, 32) and u["tly"] < t["tly"]]
        return max(cands, key=lambda u: u["tly"]) if cands else None

    # Place remaining with tiny-overlap refinement (phase correlation on strips)
    for i, t in enumerate(tiles_sorted[1:], start=2):
        img = t["img"]
        x_coarse, y_coarse = t["tlx"], t["tly"]
        dx_total = dy_total = 0.0
        used = 0

        if refine_overlap_px and refine_overlap_px > 0:
            # Left strip
            L = left_neighbor(t)
            if L is not None:
                strip_w = min(max(refine_overlap_px, 5), img.shape[1])
                mov_strip = to_gray(img[:, :strip_w]) if img.ndim==3 else img[:, :strip_w]
                xL, yL = L["tlx"], L["tly"]
                ref_x0 = xL + L["w"] - strip_w
                ref_y0 = y_coarse
                ref_x1 = ref_x0 + strip_w
                ref_y1 = ref_y0 + mov_strip.shape[0]
                if 0 <= ref_x0 < ref_x1 <= canvas_W and 0 <= ref_y0 < ref_y1 <= canvas_H:
                    ref_strip = canvas[ref_y0:ref_y1, ref_x0:ref_x1]
                    ref_strip = to_gray(ref_strip) if ref_strip.ndim==3 else ref_strip
                    if ref_strip.size == mov_strip.size and ref_strip.sum() > 0:
                        sxp, syp = phase_corr(ref_strip, mov_strip)
                        dx_total += sxp; dy_total += syp; used += 1

            # Top strip
            Tn = top_neighbor(t)
            if Tn is not None:
                strip_h = min(max(refine_overlap_px, 5), img.shape[0])
                mov_strip = to_gray(img[:strip_h, :]) if img.ndim==3 else img[:strip_h, :]
                xT, yT = Tn["tlx"], Tn["tly"]
                ref_x0 = x_coarse
                ref_y0 = yT + Tn["h"] - strip_h
                ref_x1 = ref_x0 + mov_strip.shape[1]
                ref_y1 = ref_y0 + strip_h
                if 0 <= ref_x0 < ref_x1 <= canvas_W and 0 <= ref_y0 < ref_y1 <= canvas_H:
                    ref_strip = canvas[ref_y0:ref_y1, ref_x0:ref_x1]
                    ref_strip = to_gray(ref_strip) if ref_strip.ndim==3 else ref_strip
                    if ref_strip.size == mov_strip.size and ref_strip.sum() > 0:
                        sxp, syp = phase_corr(ref_strip, mov_strip)
                        dx_total += sxp; dy_total += syp; used += 1

        dx = dx_total/used if used else 0.0
        dy = dy_total/used if used else 0.0
        x_final = int(round(x_coarse + dx))
        y_final = int(round(y_coarse + dy))
        place(canvas, img, x_final, y_final, mode=blend_mode, feather_ksize=feather_ksize)
        transforms[t["filename"]] = {"dx":float(dx), "dy":float(dy), "tlx":x_final, "tly":y_final}

        if progress_cb:
            progress_cb(i, len(tiles_sorted))

    report = {
        "ic_y_is_up": ic_y_is_up,
        "bbox_inclusive": bbox_inclusive,
        "pixels_per_unit_x": sx,
        "pixels_per_unit_y": sy,
        "refine_overlap_px": refine_overlap_px,
        "blend_mode": blend_mode,
        "tiles": transforms
    }
    return canvas, report

def encode_png(img):
    if img.dtype != np.uint8:
        img = np.clip(img, 0, 255).astype(np.uint8)
    ok, buf = cv2.imencode(".png", img)
    return buf.tobytes() if ok else None

# --------------- UI ---------------
st.set_page_config(page_title="PNG IC Tile Stitcher (BBox + Overlap Refinement)", layout="wide")
st.title("🧩 PNG IC Tile Stitcher — (x1,y1,x2,y2) + tiny-overlap refine")

st.markdown("""
**Inputs**
- PNG tiles (filenames must match the CSV)
- CSV columns: `filename,x1,y1,x2,y2` (stage coordinates)
""")

c1, c2 = st.columns(2)
with c1:
    uploaded_imgs = st.file_uploader("Upload PNG tiles (multiple)", type=["png"], accept_multiple_files=True)
with c2:
    csv_file = st.file_uploader("Upload CSV (filename,x1,y1,x2,y2)", type=["csv"])

images_by_name = {}
if uploaded_imgs:
    for f in uploaded_imgs:
        images_by_name[f.name] = {"img": read_png_bytes(f)}

if csv_file is not None:
    df = pd.read_csv(csv_file)
else:
    st.info("No CSV uploaded yet. Paste or create rows below.")
    df = pd.DataFrame(columns=["filename","x1","y1","x2","y2"])

st.markdown("### Edit / verify coordinates")
df = st.data_editor(df, num_rows="dynamic", use_container_width=True)

st.markdown("---")
st.markdown("### Settings")

cA, cB, cC = st.columns(3)
with cA:
    ic_y_is_up = st.toggle("Stage Y is up (typical IC tools)", value=True)
    bbox_inclusive = st.toggle("BBox (x2,y2) are inclusive", value=False)

with cB:
    override_scale = st.toggle("Override pixels-per-unit", value=False)
    ppux = st.number_input("pixels_per_unit_x", value=0.0, min_value=0.0, step=0.001, disabled=not override_scale, format="%.6f")
    ppuy = st.number_input("pixels_per_unit_y", value=0.0, min_value=0.0, step=0.001, disabled=not override_scale, format="%.6f")

with cC:
    refine_overlap_px = st.number_input("Refine overlap (px)", value=8, min_value=0, max_value=64, step=1)
    blend_mode = st.selectbox("Blend mode", ["feather","overwrite","average"], index=0)
    feather_ksize = st.slider("Feather kernel (odd)", min_value=1, max_value=101, value=31, step=2)
    output_color = st.toggle("Output color (convert grayscale to 3-ch)", value=False)

st.markdown("---")
run = st.button("🧵 Build Mosaic (PNG)")

if run:
    if df.empty:
        st.error("Please provide at least one CSV row.")
        st.stop()
    missing = [fn for fn in df["filename"].astype(str) if fn not in images_by_name]
    if missing:
        st.error(f"Missing PNGs for: {missing[:6]}{' ...' if len(missing)>6 else ''}")
        st.stop()

    prog = st.progress(0, text="Building mosaic...")
    def _cb(i, n):
        prog.progress(int(100*i/n), text=f"Placing tile {i}/{n}")

    try:
        px_x = ppux if (override_scale and ppux > 0) else None
        px_y = ppuy if (override_scale and ppuy > 0) else None
        mosaic, report = build_mosaic(
            df, images_by_name,
            ic_y_is_up=ic_y_is_up,
            bbox_inclusive=bbox_inclusive,
            pixels_per_unit_x=px_x,
            pixels_per_unit_y=px_y,
            refine_overlap_px=int(refine_overlap_px),
            blend_mode=blend_mode,
            feather_ksize=int(feather_ksize),
            output_color=output_color,
            progress_cb=_cb
        )
    except Exception as e:
        st.exception(e)
        st.stop()

    prog.progress(100, text="Done!")

    # Preview (scaled)
    H, W = mosaic.shape[:2]
    st.markdown("### Mosaic preview (scaled)")
    max_side = 1400
    if max(H, W) > max_side:
        scale = max_side / max(H, W)
        preview = cv2.resize(mosaic, (int(W*scale), int(H*scale)), interpolation=cv2.INTER_AREA)
    else:
        preview = mosaic
    st.image(preview, caption=f"{H} × {W} px", clamp=True)

    # Downloads
    st.markdown("### Download outputs")
    png_bytes = encode_png(mosaic)
    st.download_button("⬇️ Download mosaic.png", data=png_bytes, file_name="mosaic.png", mime="image/png")

    json_bytes = json.dumps(report, indent=2).encode("utf-8")
    st.download_button("⬇️ Download transforms.json", data=json_bytes, file_name="transforms.json", mime="application/json")

    st.markdown("### Build summary")
    st.write(f"- Pixels-per-unit: **{report['pixels_per_unit_x']:.6f} (x)**, **{report['pixels_per_unit_y']:.6f} (y)**")
    st.write(f"- Stage Y-up: **{report['ic_y_is_up']}**, Inclusive bbox: **{report['bbox_inclusive']}**")
    st.write(f"- Refinement: **{report['refine_overlap_px']} px**, Blend: **{report['blend_mode']}**")
