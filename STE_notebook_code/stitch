import io, math, json
from pathlib import Path
import numpy as np
import pandas as pd
import streamlit as st
import cv2

# --------------- Optimized for Metal Line SEM Images ---------------
def read_png_bytes(file):
    data = np.frombuffer(file.read(), np.uint8)
    img = cv2.imdecode(data, cv2.IMREAD_UNCHANGED)
    if img is None:
        raise ValueError(f"Cannot read PNG: {getattr(file, 'name', 'uploaded file')}")
    return img

def to_gray(img):
    if img.ndim == 3:
        if img.shape[2] == 4:
            img = cv2.cvtColor(img, cv2.COLOR_BGRA2BGR)
        return cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    return img

def enhance_metal_lines(img):
    """Specialized enhancement for metal line SEM images"""
    gray = to_gray(img) if img.ndim == 3 else img.copy()
    
    # Apply aggressive contrast enhancement for metal lines
    clahe = cv2.createCLAHE(clipLimit=3.0, tileGridSize=(8,8))
    enhanced = clahe.apply(gray)
    
    # Optional: binary threshold to emphasize metal lines
    _, binary = cv2.threshold(enhanced, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
    
    return enhanced, binary

def template_match_alignment(ref_region, mov_region, method=cv2.TM_CCOEFF_NORMED):
    """
    Template matching for metal line alignment
    Returns: (success, dx, dy, confidence)
    """
    try:
        # Ensure regions are the same size
        if ref_region.shape != mov_region.shape:
            # Resize mov_region to match ref_region
            mov_region = cv2.resize(mov_region, (ref_region.shape[1], ref_region.shape[0]))
        
        # Perform template matching
        result = cv2.matchTemplate(ref_region, mov_region, method)
        _, max_val, _, max_loc = cv2.minMaxLoc(result)
        
        # Calculate shift - template matching gives the top-left corner of the match
        dx = max_loc[0] - (mov_region.shape[1] // 2)
        dy = max_loc[1] - (mov_region.shape[0] // 2)
        
        # For metal lines, we need high confidence
        success = max_val > 0.4  # Higher threshold for structured patterns
        
        return success, dx, dy, max_val
        
    except Exception as e:
        return False, 0, 0, 0.0

def edge_based_alignment(ref_region, mov_region, canny_threshold1=50, canny_threshold2=150):
    """
    Edge-based alignment using Canny edges + template matching
    Excellent for metal lines with clear edges
    """
    try:
        # Convert to edges
        ref_edges = cv2.Canny(ref_region, canny_threshold1, canny_threshold2)
        mov_edges = cv2.Canny(mov_region, canny_threshold1, canny_threshold2)
        
        # If no edges detected, return failure
        if np.sum(ref_edges) == 0 or np.sum(mov_edges) == 0:
            return False, 0, 0, 0.0
        
        # Template match on edges
        return template_match_alignment(ref_edges, mov_edges, cv2.TM_CCOEFF_NORMED)
        
    except Exception:
        return False, 0, 0, 0.0

def line_based_alignment(ref_region, mov_region):
    """
    Alignment using Hough Lines for metal line structures
    """
    try:
        # Detect lines in both regions
        ref_edges = cv2.Canny(ref_region, 50, 150, apertureSize=3)
        mov_edges = cv2.Canny(mov_region, 50, 150, apertureSize=3)
        
        # Detect lines using HoughLinesP
        ref_lines = cv2.HoughLinesP(ref_edges, 1, np.pi/180, threshold=30, minLineLength=20, maxLineGap=10)
        mov_lines = cv2.HoughLinesP(mov_edges, 1, np.pi/180, threshold=30, minLineLength=20, maxLineGap=10)
        
        if ref_lines is None or mov_lines is None or len(ref_lines) < 3 or len(mov_lines) < 3:
            return False, 0, 0, 0.0
        
        # Calculate average line angles to check alignment
        def get_angles(lines):
            angles = []
            for line in lines:
                x1, y1, x2, y2 = line[0]
                angle = np.arctan2(y2 - y1, x2 - x1) * 180 / np.pi
                angles.append(angle)
            return np.array(angles)
        
        ref_angles = get_angles(ref_lines)
        mov_angles = get_angles(mov_lines)
        
        # Simple angle-based alignment (for mostly horizontal/vertical metal lines)
        ref_angle_avg = np.mean(ref_angles)
        mov_angle_avg = np.mean(mov_angles)
        
        # If angles are significantly different, alignment might be problematic
        if abs(ref_angle_avg - mov_angle_avg) > 10:
            return False, 0, 0, 0.0
        
        # Fall back to edge-based alignment
        return edge_based_alignment(ref_region, mov_region)
        
    except Exception:
        return False, 0, 0, 0.0

def phase_correlation_metal_lines(ref_region, mov_region):
    """
    Enhanced phase correlation for structured metal line patterns
    """
    try:
        # Use enhanced images for better correlation
        ref_enhanced, _ = enhance_metal_lines(ref_region)
        mov_enhanced, _ = enhance_metal_lines(mov_region)
        
        # Apply Hanning window
        h, w = ref_enhanced.shape
        win = np.outer(np.hanning(h), np.hanning(w))
        
        ref_win = ref_enhanced.astype(np.float32) * win
        mov_win = mov_enhanced.astype(np.float32) * win
        
        # Phase correlation
        (shifty, shiftx), response = cv2.phaseCorrelate(ref_win, mov_win)
        
        # Metal lines should have higher correlation response
        success = response > 0.15 and abs(shiftx) < w/2 and abs(shifty) < h/2
        
        return success, float(shiftx), float(shifty), response
        
    except Exception:
        return False, 0, 0, 0.0

def multi_method_alignment(ref_region, mov_region, methods_to_try=3):
    """
    Try multiple alignment methods and pick the best one
    """
    best_dx, best_dy = 0, 0
    best_confidence = 0
    best_method = "none"
    
    methods = [
        ("edge_based", edge_based_alignment),
        ("template", lambda r, m: template_match_alignment(r, m, cv2.TM_CCOEFF_NORMED)),
        ("phase_corr", phase_correlation_metal_lines),
        ("line_based", line_based_alignment)
    ]
    
    # Try the specified number of methods
    for method_name, method_func in methods[:methods_to_try]:
        success, dx, dy, confidence = method_func(ref_region, mov_region)
        
        if success and confidence > best_confidence:
            best_dx, best_dy = dx, dy
            best_confidence = confidence
            best_method = method_name
    
    return best_method != "none", best_dx, best_dy, best_confidence, best_method

def feather_blend(canvas, tile, x, y, ksize=51):
    """Feather blending for smooth transitions"""
    H, W = canvas.shape[:2]
    h, w = tile.shape[:2]
    x0, y0 = max(0, x), max(0, y)
    x1, y1 = min(W, x + w), min(H, y + h)
    if x0 >= x1 or y0 >= y1:
        return
    
    c = canvas[y0:y1, x0:x1]
    t = tile[y0 - y : y0 - y + (y1 - y0), x0 - x : x0 - x + (x1 - x0)]
    
    mask = (t > 0).astype(np.float32)
    if ksize % 2 == 0: 
        ksize += 1
    if ksize > 1:
        mask = cv2.GaussianBlur(mask, (ksize, ksize), 0)
    
    c[:] = (c.astype(np.float32) * (1 - mask) + t.astype(np.float32) * mask).astype(canvas.dtype)

def estimate_scale(df, images_by_name, bbox_inclusive):
    """Estimate pixels per unit from coordinate data"""
    sx_list, sy_list = [], []
    for _, r in df.iterrows():
        name = str(r["filename"])
        if name not in images_by_name: 
            continue
        img = images_by_name[name]["img"]
        h, w = img.shape[:2]
        dx = float(r["x2"]) - float(r["x1"]) + (1 if bbox_inclusive else 0)
        dy = float(r["y2"]) - float(r["y1"]) + (1 if bbox_inclusive else 0)
        if dx <= 0 or dy <= 0: 
            continue
        sx_list.append(w / dx)
        sy_list.append(h / dy)
    
    if not sx_list or not sy_list:
        raise RuntimeError("Could not estimate pixels-per-unit — check CSV/images.")
    
    return float(np.median(sx_list)), float(np.median(sy_list))

def build_mosaic_metal_lines(
    df, images_by_name,
    ic_y_is_up=True,
    bbox_inclusive=False,
    pixels_per_unit_x=None,
    pixels_per_unit_y=None,
    analysis_size=100,  # Size of region to analyze for alignment
    min_confidence=0.3,
    alignment_methods=2,  # Number of methods to try
    blend_mode="feather",
    feather_ksize=51,
    output_color=False,
    progress_cb=None
):
    """Optimized mosaic building for SEM metal line images"""
    
    # Validate and prepare data
    df = df.copy()
    for col in ["x1","y1","x2","y2"]:
        df[col] = pd.to_numeric(df[col], errors="coerce")
    
    if df[["x1","y1","x2","y2"]].isnull().any().any():
        raise ValueError("CSV contains non-numeric coordinates.")

    # Load and preprocess tiles
    tiles = []
    for _, r in df.iterrows():
        name = str(r["filename"])
        if name not in images_by_name:
            raise FileNotFoundError(f"Missing image: {name}")
        
        raw = images_by_name[name]["img"]
        img = raw.copy()
        
        # Convert to desired format
        if output_color:
            if img.ndim == 2:
                img = cv2.cvtColor(img, cv2.COLOR_GRAY2BGR)
            elif img.shape[2] == 4:
                img = cv2.cvtColor(img, cv2.COLOR_BGRA2BGR)
        else:
            img = to_gray(img)
        
        h, w = img.shape[:2]
        x1, y1, x2, y2 = map(float, [r["x1"], r["y1"], r["x2"], r["y2"]])
        dx = x2 - x1 + (1 if bbox_inclusive else 0)
        dy = y2 - y1 + (1 if bbox_inclusive else 0)
        
        tiles.append({
            "filename": name, "img": img, "h": h, "w": w, 
            "x1": x1, "y1": y1, "x2": x2, "y2": y2, 
            "dx": dx, "dy": dy
        })

    # Estimate scale
    if pixels_per_unit_x is None or pixels_per_unit_y is None:
        sx, sy = estimate_scale(df, images_by_name, bbox_inclusive)
    else:
        sx, sy = float(pixels_per_unit_x), float(pixels_per_unit_y)

    # Calculate canvas size
    xs, ys = [], []
    for t in tiles:
        xs += [t["x1"], t["x2"]]
        ys += [t["y1"], t["y2"]]
    xmin, xmax = min(xs), max(xs)
    ymin, ymax = min(ys), max(ys)

    # Map coordinates to canvas
    for t in tiles:
        if ic_y_is_up:
            tly = (ymax - t["y1"]) * sy
        else:
            tly = (t["y1"] - ymin) * sy
        tlx = (t["x1"] - xmin) * sx
        t["tlx"], t["tly"] = int(round(tlx)), int(round(tly))

    # Create canvas with padding
    canvas_W = int(math.ceil((xmax - xmin) * sx)) + 200
    canvas_H = int(math.ceil((ymax - ymin) * sy)) + 200
    
    if output_color:
        canvas = np.zeros((canvas_H, canvas_W, 3), dtype=np.uint8)
    else:
        canvas = np.zeros((canvas_H, canvas_W), dtype=np.uint8)

    # Sort tiles by position
    tiles_sorted = sorted(tiles, key=lambda t: (t["tly"], t["tlx"]))
    transforms = {}
    alignment_report = []

    # Helper functions to find neighbors
    def left_neighbor(t):
        cands = [u for u in tiles_sorted if u is not t 
                 and abs(u["tly"] - t["tly"]) < max(t["h"] * 0.3, 150)
                 and u["tlx"] < t["tlx"]]
        return max(cands, key=lambda u: u["tlx"]) if cands else None

    def top_neighbor(t):
        cands = [u for u in tiles_sorted if u is not t 
                 and abs(u["tlx"] - t["tlx"]) < max(t["w"] * 0.3, 150)
                 and u["tly"] < t["tly"]]
        return max(cands, key=lambda u: u["tly"]) if cands else None

    # Place first tile
    t0 = tiles_sorted[0]
    feather_blend(canvas, t0["img"], t0["tlx"], t0["tly"], ksize=feather_ksize)
    transforms[t0["filename"]] = {
        "dx": 0.0, "dy": 0.0, 
        "tlx": t0["tlx"], "tly": t0["tly"],
        "method": "initial", "confidence": 1.0
    }

    # Place remaining tiles with metal-line optimized alignment
    for i, t in enumerate(tiles_sorted[1:], start=2):
        img = t["img"]
        x_coarse, y_coarse = t["tlx"], t["tly"]
        
        dx_total, dy_total = 0.0, 0.0
        alignment_sources = 0
        alignment_details = []
        
        # Try alignment with left neighbor
        L = left_neighbor(t)
        if L is not None:
            # Use larger analysis regions for metal lines
            analysis_width = min(analysis_size, t["w"] // 3, L["w"] // 3)
            analysis_height = min(t["h"], L["h"], 200)  # Limit height for stability
            
            # Extract from current tile (left side)
            mov_region = img[:, :analysis_width]
            
            # Extract from canvas where left neighbor should be
            ref_x0 = L["tlx"] + L["w"] - analysis_width
            ref_y0 = max(0, min(y_coarse, canvas_H - analysis_height))
            ref_x1 = ref_x0 + analysis_width
            ref_y1 = ref_y0 + analysis_height
            
            if (0 <= ref_x0 < ref_x1 <= canvas_W and 
                0 <= ref_y0 < ref_y1 <= canvas_H):
                
                ref_region = canvas[ref_y0:ref_y1, ref_x0:ref_x1]
                
                if ref_region.size > 0 and mov_region.size > 0:
                    # Ensure same dimensions
                    if ref_region.shape != mov_region.shape:
                        mov_region = cv2.resize(mov_region, (ref_region.shape[1], ref_region.shape[0]))
                    
                    # Try multiple alignment methods
                    success, dx, dy, confidence, method = multi_method_alignment(
                        ref_region, mov_region, methods_to_try=alignment_methods
                    )
                    
                    if success and confidence >= min_confidence:
                        dx_total += dx
                        dy_total += dy
                        alignment_sources += 1
                        
                        alignment_details.append({
                            "neighbor": "left",
                            "method": method,
                            "confidence": confidence,
                            "dx": dx,
                            "dy": dy
                        })

        # Try alignment with top neighbor
        T = top_neighbor(t)
        if T is not None:
            analysis_height = min(analysis_size, t["h"] // 3, T["h"] // 3)
            analysis_width = min(t["w"], T["w"], 200)
            
            mov_region = img[:analysis_height, :]
            
            ref_x0 = max(0, min(x_coarse, canvas_W - analysis_width))
            ref_y0 = T["tly"] + T["h"] - analysis_height
            ref_x1 = ref_x0 + analysis_width
            ref_y1 = ref_y0 + analysis_height
            
            if (0 <= ref_x0 < ref_x1 <= canvas_W and 
                0 <= ref_y0 < ref_y1 <= canvas_H):
                
                ref_region = canvas[ref_y0:ref_y1, ref_x0:ref_x1]
                
                if ref_region.size > 0 and mov_region.size > 0:
                    if ref_region.shape != mov_region.shape:
                        mov_region = cv2.resize(mov_region, (ref_region.shape[1], ref_region.shape[0]))
                    
                    success, dx, dy, confidence, method = multi_method_alignment(
                        ref_region, mov_region, methods_to_try=alignment_methods
                    )
                    
                    if success and confidence >= min_confidence:
                        dx_total += dx
                        dy_total += dy
                        alignment_sources += 1
                        
                        alignment_details.append({
                            "neighbor": "top",
                            "method": method,
                            "confidence": confidence,
                            "dx": dx,
                            "dy": dy
                        })

        # Calculate final adjustment
        if alignment_sources > 0:
            dx_final = dx_total / alignment_sources
            dy_final = dy_total / alignment_sources
            avg_confidence = np.mean([d["confidence"] for d in alignment_details])
        else:
            dx_final, dy_final = 0.0, 0.0
            avg_confidence = 0.0

        x_final = int(round(x_coarse + dx_final))
        y_final = int(round(y_coarse + dy_final))
        
        # Place tile
        feather_blend(canvas, img, x_final, y_final, ksize=feather_ksize)
        
        # Record transformation
        transforms[t["filename"]] = {
            "dx": float(dx_final), 
            "dy": float(dy_final), 
            "tlx": x_final, 
            "tly": y_final,
            "method": "metal_line_alignment",
            "confidence": avg_confidence,
            "alignments": alignment_details
        }
        
        alignment_report.append({
            "tile": t["filename"],
            "alignments": alignment_details,
            "final_shift": (dx_final, dy_final)
        })

        if progress_cb:
            progress_cb(i, len(tiles_sorted))

    # Crop canvas to content
    non_zero_coords = np.where(canvas > 0)
    if len(non_zero_coords[0]) > 0:
        min_y, max_y = np.min(non_zero_coords[0]), np.max(non_zero_coords[0])
        min_x, max_x = np.min(non_zero_coords[1]), np.max(non_zero_coords[1])
        canvas = canvas[min_y:max_y+1, min_x:max_x+1]
        
        # Update positions
        for tile_info in transforms.values():
            tile_info["tlx"] -= min_x
            tile_info["tly"] -= min_y

    report = {
        "ic_y_is_up": ic_y_is_up,
        "bbox_inclusive": bbox_inclusive,
        "pixels_per_unit_x": sx,
        "pixels_per_unit_y": sy,
        "analysis_size": analysis_size,
        "min_confidence": min_confidence,
        "alignment_methods": alignment_methods,
        "alignment_report": alignment_report,
        "tiles": transforms
    }
    
    return canvas, report

def encode_png(img):
    """Encode image as PNG bytes"""
    if img.dtype != np.uint8:
        img = np.clip(img, 0, 255).astype(np.uint8)
    ok, buf = cv2.imencode(".png", img)
    return buf.tobytes() if ok else None

