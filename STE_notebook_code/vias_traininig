def visualize_results(model, dataloader, num_samples=3):
    """Visualize model predictions for error analysis"""
    model.eval()
    with torch.no_grad():
        for i, (images, masks) in enumerate(dataloader):
            if i >= num_samples:
                break
                
            images, masks = images.to(device), masks.to(device)
            outputs = model(images)
            preds = torch.sigmoid(outputs) > 0.5
            
            for j in range(images.size(0)):
                plt.figure(figsize=(15, 5))
                
                # Original image
                plt.subplot(1, 3, 1)
                plt.imshow(images[j].cpu().squeeze(), cmap='gray')
                plt.title("Input Image")
                
                # Ground truth
                plt.subplot(1, 3, 2)
                plt.imshow(masks[j].cpu().squeeze(), cmap='jet')
                plt.title("Ground Truth")
                
                # Prediction
                plt.subplot(1, 3, 3)
                plt.imshow(preds[j].float().cpu().squeeze(), cmap='jet')
                plt.title("Prediction")
                
                plt.show()

