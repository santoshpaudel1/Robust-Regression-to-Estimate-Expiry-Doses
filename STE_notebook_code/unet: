# ========================= Train / Validate =========================
def train_one_epoch(model, loader, device):
    model.train(); run_loss=0.0; run_iou=0.0
    for i,(images,masks) in enumerate(loader):
        images=images.to(device, non_blocking=True); masks=masks.to(device, non_blocking=True)
        optimizer.zero_grad(set_to_none=True)
        with autocast_ctx(MIXED_PRECISION):
            logits = model(images)
            loss   = criterion(logits, masks)
        scaler.scale(loss).backward()
        scaler.step(optimizer); scaler.update()
        with torch.no_grad():
            run_loss += loss.item() * images.size(0)
            run_iou  += iou_from_logits(logits, masks, threshold=0.7).item() * images.size(0)
        if use_cuda and (i % 8 == 0): clear_memory()
    n=len(loader.dataset); return run_loss/n, run_iou/n

@torch.no_grad()
def validate(model, loader, device):
    model.eval(); run_loss=0.0; run_iou=0.0
    for images,masks in loader:
        images=images.to(device, non_blocking=True); masks=masks.to(device, non_blocking=True)
        with autocast_ctx(MIXED_PRECISION):
            logits = predict_with_tta(model, images, tta_scales=TTA_SCALES, stride=32)
            loss   = criterion(logits, masks)
        run_loss += loss.item() * images.size(0)
        run_iou  += iou_from_logits(logits, masks, threshold=0.5).item() * images.size(0)
    n=len(loader.dataset); return run_loss/n, run_iou/n

