        msk = msk.resize((self.img_size, self.img_size), resample=Image.NEAREST)

        img_np = (np.array(img, dtype=np.float32)/255.0)[...,None]
        msk_np = ((np.array(msk, dtype=np.float32)/255.0) > 0.5).astype(np.float32)[...,None]

        if self.augment and self.custom_transform is not None:
            return self.custom_transform(img_np, msk_np)
        else:
            img_t  = torch.tensor(img_np, dtype=torch.float32).permute(2,0,1)  # (1,H,W)
            msk_t  = torch.tensor(msk_np, dtype=torch.float32).permute(2,0,1)  # (1,H,W)
            return img_t, msk_t

