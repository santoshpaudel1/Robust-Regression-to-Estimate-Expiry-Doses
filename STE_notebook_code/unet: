def autocast_ctx(enabled: bool = True, dtype=None):
    """
    Portable autocast context:
    - CUDA: prefers bfloat16 on Ampere+, else float16
    - CPU: disabled (safer)
    """
    if not enabled:
        from contextlib import nullcontext
        return nullcontext()
    if torch.cuda.is_available():
        if dtype is None:
            dtype = torch.bfloat16 if torch.cuda.is_bf16_supported() else torch.float16
        return torch.autocast(device_type='cuda', dtype=dtype)
    else:
        from contextlib import nullcontext
        return nullcontext()

