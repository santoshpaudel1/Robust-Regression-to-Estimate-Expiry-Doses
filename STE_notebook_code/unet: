# ---------------- helpers: pairing by numeric ID ----------------
def list_images(root: str, exts=('.png', '.jpg', '.jpeg', '.tif', '.tiff')) -> List[str]:
    return [os.path.join(root, f) for f in os.listdir(root)
            if os.path.isfile(os.path.join(root, f)) and f.lower().endswith(exts)]

def extract_id(stem: str) -> str:
    """
    Extract the trailing digits as the pairing key. E.g.:
      'patch_474' -> '474'
      'mask_007'  -> '007'
    If no digits, fall back to the whole stem.
    """
    s = stem.strip().lower()
    # strip common prefixes (optional)
    for pref in ('patch_', 'mask_', 'img_', 'image_', 'm_', 'p_'):
        if s.startswith(pref):
            s = s[len(pref):]
    m = re.search(r'(\d+)$', s)
    return m.group(1) if m else s

def load_data_paths_by_id(patch_dir: str, mask_dir: str,
                          exts=('.png', '.jpg', '.jpeg', '.tif', '.tiff')) -> Tuple[List[str], List[str]]:
    if not os.path.isdir(patch_dir):
        raise FileNotFoundError(f"PATCH_DIR not found: {patch_dir}")
    if not os.path.isdir(mask_dir):
        raise FileNotFoundError(f"MASK_DIR not found: {mask_dir}")

    img_files = list_images(patch_dir, exts)
    msk_files = list_images(mask_dir,  exts)
    if not img_files:
        raise FileNotFoundError(f"No image files with {exts} found in {patch_dir}")
    if not msk_files:
        raise FileNotFoundError(f"No mask files with {exts} found in {mask_dir}")

    img_map = {}
    for p in img_files:
        kid = extract_id(Path(p).stem)
        # keep first occurrence (deterministic order by list_images)
        img_map.setdefault(kid, p)

    msk_map = {}
    for p in msk_files:
        kid = extract_id(Path(p).stem)
        msk_map.setdefault(kid, p)

    # Sort numeric IDs numerically when possible
    def sort_key(k):
        return (0, int(k)) if k.isdigit() else (1, k)
    keys = sorted(set(img_map) & set(msk_map), key=sort_key)

    missing_imgs = sorted(set(msk_map) - set(img_map), key=sort_key)[:10]
    missing_msks = sorted(set(img_map) - set(msk_map), key=sort_key)[:10]

    print(f"Found IDs -> images: {len(img_map)}, masks: {len(msk_map)}, paired: {len(keys)}")
    if missing_imgs:
        print("⚠️ IDs present in masks but missing in images (first 10):", missing_imgs)
    if missing_msks:
        print("⚠️ IDs present in images but missing in masks  (first 10):", missing_msks)

    if not keys:
        raise AssertionError("No matching IDs between images and masks. Check filename patterns.")

    image_paths = [img_map[k] for k in keys]
    mask_paths  = [msk_map[k] for k in keys]
    return image_paths, mask_paths

# ---------------- split helper ----------------
def split_paths(image_paths: List[str], mask_paths: List[str],
                val_ratio: float = 0.15, seed: int = 42, shuffle: bool = True):
    assert len(image_paths) == len(mask_paths), "Image/Mask count mismatch before split."
    n = len(image_paths)
    idx = list(range(n))
    rnd = np.random.RandomState(seed)
    if shuffle:
        rnd.shuffle(idx)
    n_val = max(1, int(n * val_ratio))
    val_idx = idx[:n_val]
    trn_idx = idx[n_val:]
    X_train = [image_paths[i] for i in trn_idx]
    y_train = [mask_paths[i]  for i in trn_idx]
    X_val   = [image_paths[i] for i in val_idx]
    y_val   = [mask_paths[i]  for i in val_idx]
    return X_train, X_val, y_train, y_val

