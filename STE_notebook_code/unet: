# ========================= IO helpers =========================
def list_images(root: str, exts=('.png', '.jpg', '.jpeg', '.tif', '.tiff')) -> List[str]:
    return [os.path.join(root, f) for f in os.listdir(root)
            if os.path.isfile(os.path.join(root, f)) and f.lower().endswith(exts)]

def extract_id(stem: str) -> str:
    s = stem.strip().lower()
    for pref in ('patch_', 'mask_', 'img_', 'image_', 'm_', 'p_'):
        if s.startswith(pref): s = s[len(pref):]
    m = re.search(r'(\d+)$', s)
    return m.group(1) if m else s

def load_data_paths_by_id(patch_dir: str, mask_dir: str,
                          exts=('.png', '.jpg', '.jpeg', '.tif', '.tiff')) -> Tuple[List[str], List[str]]:
    if not os.path.isdir(patch_dir): raise FileNotFoundError(f"PATCH_DIR not found: {patch_dir}")
    if not os.path.isdir(mask_dir):  raise FileNotFoundError(f"MASK_DIR not found: {mask_dir}")
    img_files = list_images(patch_dir, exts); msk_files = list_images(mask_dir,  exts)
    if not img_files: raise FileNotFoundError(f"No image files with {exts} in {patch_dir}")
    if not msk_files: raise FileNotFoundError(f"No mask files with {exts} in {mask_dir}")

    img_map, msk_map = {}, {}
    for p in img_files: img_map.setdefault(extract_id(Path(p).stem), p)
    for p in msk_files: msk_map.setdefault(extract_id(Path(p).stem), p)

    def sort_key(k): return (0, int(k)) if k.isdigit() else (1, k)
    keys = sorted(set(img_map) & set(msk_map), key=sort_key)
    if not keys: raise AssertionError("No matching IDs between images and masks.")
    return [img_map[k] for k in keys], [msk_map[k] for k in keys]

def split_paths(image_paths: List[str], mask_paths: List[str],
                val_ratio: float = 0.15, seed: int = 42, shuffle: bool = True):
    assert len(image_paths) == len(mask_paths)
    n = len(image_paths)
    idx = list(range(n)); rng = np.random.RandomState(seed)
    if shuffle: rng.shuffle(idx)
    n_val = max(1, int(n * val_ratio))
    val_idx = idx[:n_val]; trn_idx = idx[n_val:]
    return ([image_paths[i] for i in trn_idx],
            [image_paths[i] for i in val_idx],
            [mask_paths[i]  for i in trn_idx],
            [mask_paths[i]  for i in val_idx])

# ========================= Anti-aliased resize =========================
try:
    _BICUBIC  = Image.Resampling.BICUBIC
    _LANCZOS  = Image.Resampling.LANCZOS
    _NEAREST  = Image.Resampling.NEAREST
    _BILINEAR = Image.Resampling.BILINEAR
except Exception:
    _BICUBIC  = Image.BICUBIC
    _LANCZOS  = Image.LANCZOS
    _NEAREST  = Image.NEAREST
    _BILINEAR = Image.BILINEAR

def aa_resize(pil_img: Image.Image, size_hw: Tuple[int,int]) -> Image.Image:
    W, H = size_hw
    w0, h0 = pil_img.size
    resample = _LANCZOS if (W < w0 or H < h0) else _BICUBIC
    return pil_img.resize((W, H), resample=resample)

# ========================= Light SEM augment focused on geometry =========================
class AdvancedSEMTransform:
    def __init__(self, img_size: Optional[int] = 256):
        self.img_size = img_size
    @staticmethod
    def _to_pil(img: np.ndarray) -> Image.Image:
        if img.ndim==3 and img.shape[2]==1: img = img[...,0]
        img8 = (np.clip(img,0,1)*255).astype(np.uint8)
        return Image.fromarray(img8, mode='L')
    @staticmethod
    def _to_np(pil_img: Image.Image) -> np.ndarray:
        arr = np.array(pil_img, dtype=np.uint8).astype(np.float32)/255.0
        if arr.ndim==3: arr = arr[...,0]
        return arr
    def __call__(self, img: np.ndarray, mask: np.ndarray):
        img = np.asarray(img).astype(np.float32); mask = np.asarray(mask).astype(np.float32)
        if img.ndim==3 and img.shape[2]==1: img = img[...,0]
        if mask.ndim==3 and mask.shape[2]==1: mask = mask[...,0]
        img = np.clip(img,0,1); mask = (mask>0.5).astype(np.float32)

        I = self._to_pil(img); M = self._to_pil(mask)
        # flips + tiny affine
        if random.random() < 0.5: I = I.transpose(Image.FLIP_LEFT_RIGHT); M = M.transpose(Image.FLIP_LEFT_RIGHT)
        if random.random() < 0.5: I = I.transpose(Image.FLIP_TOP_BOTTOM);  M = M.transpose(Image.FLIP_TOP_BOTTOM)
        if random.random() < 0.3:
            deg = random.uniform(-5.0,5.0); tx=random.uniform(-0.05,0.05); ty=random.uniform(-0.05,0.05)
            shx=random.uniform(-5.0,5.0); shy=random.uniform(-5.0,5.0)
            iw,ih = I.size
            I = TF.affine(I, angle=deg, translate=(int(tx*iw),int(ty*ih)),
                          scale=1.0, shear=(shx,shy), interpolation=InterpolationMode.BILINEAR)
            M = TF.affine(M, angle=deg, translate=(int(tx*iw),int(ty*ih)),
                          scale=1.0, shear=(shx,shy), interpolation=InterpolationMode.NEAREST)
        # final AA resize
        if self.img_size is not None:
            I = aa_resize(I, (self.img_size, self.img_size))
            M = M.resize((self.img_size, self.img_size), resample=_NEAREST)

        img = self._to_np(I); mask = self._to_np(M); mask = (mask>0.5).astype(np.float32)
        I = Image.fromarray((img*255).astype(np.uint8)); M = Image.fromarray((mask*255).astype(np.uint8))
        img_t = TF.to_tensor(I); mask_t = (TF.to_tensor(M) > 0.5).float()
        return img_t, mask_t

# ========================= Dataset with pre-upscale (val/test) =========================
class ViaDataset(Dataset):
    def __init__(self, image_paths: List[str], mask_paths: List[str],
                 img_size: int = 256, augment: bool = False, pre_upscale: float = 1.0):
        assert len(image_paths) == len(mask_paths)
        self.image_paths = image_paths; self.mask_paths = mask_paths
        self.img_size = img_size; self.augment = augment; self.pre_upscale = pre_upscale
        self.custom_transform = AdvancedSEMTransform(img_size=None) if augment else None

    def __len__(self): return len(self.image_paths)

    def __getitem__(self, idx: int):
        img = Image.open(self.image_paths[idx]).convert('L')
        msk = Image.open(self.mask_paths[idx]).convert('L')

        # Pre-upscale for non-aug (val/test)
        if (not self.augment) and (self.pre_upscale != 1.0):
            new_w = max(1, int(img.size[0]*self.pre_upscale))
            new_h = max(1, int(img.size[1]*self.pre_upscale))
            img = aa_resize(img, (new_w, new_h))               # BICUBIC enlarge
            msk = msk.resize((new_w, new_h), resample=_NEAREST)

        # Final AA resize to model input
        img = aa_resize(img, (self.img_size, self.img_size))
        msk = msk.resize((self.img_size, self.img_size), resample=_NEAREST)

        img_np  = (np.array(img, dtype=np.float32)/255.0)[...,None]
        msk_np  = ((np.array(msk, dtype=np.float32)/255.0) > 0.5).astype(np.float32)[...,None]

        if self.augment and self.custom_transform is not None:
            img_t, msk_t = self.custom_transform(img_np, msk_np)
            # ensure final size
            I = Image.fromarray((img_t.squeeze(0).numpy()*255).astype(np.uint8))
            M = Image.fromarray((msk_t.squeeze(0).numpy()*255).astype(np.uint8))
            I = aa_resize(I, (self.img_size, self.img_size))
            M = M.resize((self.img_size, self.img_size), resample=_NEAREST)
            return TF.to_tensor(I), (TF.to_tensor(M)>0.5).float()

        return (torch.tensor(img_np, dtype=torch.float32).permute(2,0,1),
                torch.tensor(msk_np, dtype=torch.float32).permute(2,0,1))

