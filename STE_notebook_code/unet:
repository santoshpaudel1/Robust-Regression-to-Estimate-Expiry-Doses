        if self.augment and self.custom_transform is not None:
            # Use provided AdvancedSEMTransform
            return self.custom_transform(img_np, mask_np)
        else:
            # Simple tensor conversion
            img_t  = torch.tensor(img_np, dtype=torch.float32).permute(2, 0, 1)
            mask_t = torch.tensor(mask_np, dtype=torch.float32).permute(2, 0, 1)
