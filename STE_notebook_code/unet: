@torch.no_grad()
def iou_from_logits(logits: torch.Tensor, targets: torch.Tensor,
                    threshold: float = 0.5, eps: float = 1e-6) -> torch.Tensor:
    probs = torch.sigmoid(logits)
    preds = (probs > threshold).float()
    t = targets.float()
    dims = tuple(range(2, preds.ndim))
    inter = (preds * t).sum(dims)
    union = preds.sum(dims) + t.sum(dims) - inter
    return ((inter + eps) / (union + eps)).mean()



def train_one_epoch(model, loader, device):
    model.train()
    running = 0.0
    for images, masks in loader:
        images = images.to(device, non_blocking=True)
        masks  = masks.to(device, non_blocking=True)

        optimizer.zero_grad(set_to_none=True)
        with torch.autocast(
            device_type='cuda',
            dtype=(torch.bfloat16 if torch.cuda.is_bf16_supported() else torch.float16),
            enabled=torch.cuda.is_available() and MIXED_PRECISION
        ):
            logits = model(images)
        loss = total_loss_fn(logits, masks)

        scaler.scale(loss).backward()
        scaler.step(optimizer)
        scaler.update()

        running += loss.item() * images.size(0)
    return running / len(loader.dataset)

@torch.no_grad()
def validate(model, loader, device):
    model.eval()
    val_loss = 0.0
    val_iou  = 0.0
    for images, masks in loader:
        images = images.to(device, non_blocking=True)
        masks  = masks.to(device, non_blocking=True)
        with torch.autocast(
            device_type='cuda',
            dtype=(torch.bfloat16 if torch.cuda.is_bf16_supported() else torch.float16),
            enabled=torch.cuda.is_available() and MIXED_PRECISION
        ):
            logits = model(images)
        loss = total_loss_fn(logits, masks)
        val_loss += loss.item() * images.size(0)
        val_iou  += iou_from_logits(logits, masks, threshold=0.5).item() * images.size(0)

    n = len(loader.dataset)
    return val_loss / n, val_iou / n




