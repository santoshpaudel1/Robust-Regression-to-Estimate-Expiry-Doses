    elif preset == "convnext_base":
        return MetalUNetPP('timm-convnext_base','imagenet',in_channels,classes,(256,128,64,32,16),None)
    else:
        raise ValueError(f"Unknown preset '{preset}'")

# ========================= Losses: FocalDice + EdgeConsistency =========================
class FocalDiceLoss(nn.Module):
    def __init__(self, alpha=0.8, gamma=2.0, smooth=1e-6):
        super().__init__()
        self.alpha=alpha; self.gamma=gamma; self.smooth=smooth
        self.bce_logits = nn.BCEWithLogitsLoss(reduction='none')
    def forward(self, logits, targets):
        t = targets.float()
        bce = self.bce_logits(logits, t)
        p = torch.sigmoid(logits)
        p_t = t*p + (1-t)*(1-p)
        focal = (self.alpha * (1 - p_t).clamp_(1e-6).pow(self.gamma) * bce).mean()
        inter = (p*t).sum(dim=(1,2,3)); denom = p.sum(dim=(1,2,3)) + t.sum(dim=(1,2,3))
        dice = 1 - ((2*inter + self.smooth) / (denom + self.smooth)).mean()
        return focal + dice

class EdgeConsistencyLoss(nn.Module):
    """
    Match Sobel edges of prediction (sigmoid(logits)) and target mask.
    Encourages sharp, separated traces.
    """
    def __init__(self, reduction='mean'):
        super().__init__()
        self.reduction = reduction
        kx = torch.tensor([[ 1, 0,-1],[ 2, 0,-2],[ 1, 0,-1]], dtype=torch.float32).view(1,1,3,3)
        ky = torch.tensor([[ 1, 2, 1],[ 0, 0, 0],[-1,-2,-1]], dtype=torch.float32).view(1,1,3,3)
        self.register_buffer('kx', kx); self.register_buffer('ky', ky)
    def forward(self, logits, targets):
        probs = torch.sigmoid(logits)
        t = targets.float()
        kx = self.kx.to(device=probs.device, dtype=probs.dtype)
        ky = self.ky.to(device=probs.device, dtype=probs.dtype)
        px = F.conv2d(probs, kx, padding=1); py = F.conv2d(probs, ky, padding=1)
        tx = F.conv2d(t,     kx, padding=1); ty = F.conv2d(t,     ky, padding=1)
        p_edge = (px.abs() + py.abs()).clamp_(0,1)
        t_edge = (tx.abs() + ty.abs()).clamp_(0,1)
        loss = F.binary_cross_entropy(p_edge, t_edge, reduction='none')
        return loss.mean() if self.reduction=='mean' else (loss.sum() if self.reduction=='sum' else loss)

class TotalLoss(nn.Module):
    def __init__(self, base_loss, edge_w: float = 0.25):
        super().__init__()
        self.base = base_loss
        self.edge = EdgeConsistencyLoss()
        self.edge_w = edge_w
    def forward(self, logits, targets):
        return self.base(logits, targets) + self.edge_w * self.edge(logits, targets)

@torch.no_grad()
def iou_from_logits(logits: torch.Tensor, targets: torch.Tensor, threshold: float = 0.5, eps: float = 1e-6) -> torch.Tensor:
    probs = torch.sigmoid(logits); preds = (probs > threshold).float(); t = targets.float()
    dims = tuple(range(2, preds.ndim)); inter = (preds * t).sum(dims); union = preds.sum(dims) + t.sum(dims) - inter
    return ((inter + eps) / (union + eps)).mean()

# ========================= TTA: stride-safe pad→model→unpad =========================
def _next_multiple(x, m=32): return (x + m - 1) // m * m

def pad_to_stride(x: torch.Tensor, stride: int = 32, mode: str = "reflect"):
    B,C,H,W = x.shape; Hn,Wn = _next_multiple(H,stride), _next_multiple(W,stride)
    ph,pw = Hn-H, Wn-W
    if ph==0 and pw==0: return x, (0,0,0,0)
    x_pad = F.pad(x, (0,pw,0,ph), mode=mode)  # (L,R,T,B)
    return x_pad, (0,ph,0,pw)

def unpad(x: torch.Tensor, pads):
    t,b,l,r = pads; H_pad,W_pad = x.shape[-2:]
    return x[..., t:H_pad-b if b>0 else None, l:W_pad-r if r>0 else None]

@torch.no_grad()
def predict_with_tta(model, images, tta_scales=TTA_SCALES, stride=32):
    B,C,H,W = images.shape
    device = next(model.parameters()).device
    acc = torch.zeros((B,1,H,W), dtype=torch.float32, device=device)
    for s in tta_scales:
        if s == 1.0:
            im_s = images
        else:
            mode = 'bicubic' if s > 1.0 else 'area'
            im_s = F.interpolate(images, scale_factor=s, mode=mode, align_corners=False if mode!='area' else None)
        im_pad, pads = pad_to_stride(im_s, stride=stride, mode="reflect")
        logits_pad = model(im_pad)
        logits_s = unpad(logits_pad, pads)
        logits_native = F.interpolate(logits_s, size=(H,W), mode='bicubic', align_corners=False)
        acc += logits_native.float()
    return acc / float(len(tta_scales))

# ========================= Build model, optim, scaler =========================
