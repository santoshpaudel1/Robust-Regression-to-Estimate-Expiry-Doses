# ========= Model defs =========
def Norm(c, g=8):
    g = min(g, c) if c % g == 0 else 1
    return nn.GroupNorm(g, c)

class ResConvBlock(nn.Module):
    def __init__(self, in_ch, out_ch, dropout=0.0):
        super().__init__()
        self.proj = nn.Identity() if in_ch == out_ch else nn.Conv2d(in_ch, out_ch, 1)
        self.block = nn.Sequential(
            Norm(in_ch), nn.ReLU(inplace=True),
            nn.Conv2d(in_ch, out_ch, 3, padding=1),
            Norm(out_ch), nn.ReLU(inplace=True),
            nn.Conv2d(out_ch, out_ch, 3, padding=1),
            nn.Dropout2d(dropout) if dropout>0 else nn.Identity(),
        )
    def forward(self, x): return self.proj(x) + self.block(x)

class scSE(nn.Module):
    def __init__(self, ch, r=16):
        super().__init__()
        self.cSE = nn.Sequential(nn.AdaptiveAvgPool2d(1), nn.Conv2d(ch, ch//r, 1), nn.ReLU(inplace=True), nn.Conv2d(ch//r, ch, 1), nn.Sigmoid())
        self.sSE = nn.Sequential(nn.Conv2d(ch, 1, 1), nn.Sigmoid())
    def forward(self, x): return x*self.cSE(x) + x*self.sSE(x)

class AttentionGate(nn.Module):
    def __init__(self, F_g, F_l, F_int):
        super().__init__()
        self.W_g = nn.Conv2d(F_g, F_int, 1); self.W_x = nn.Conv2d(F_l, F_int, 1)
        self.psi  = nn.Sequential(nn.ReLU(inplace=True), nn.Conv2d(F_int, 1, 1), nn.Sigmoid())
    def forward(self, g, x): return x * self.psi(self.W_g(g) + self.W_x(x))

class Up(nn.Module):
    def __init__(self, in_ch, out_ch):
        super().__init__(); self.conv = nn.Conv2d(in_ch, out_ch, 3, padding=1)
    def forward(self, x): return self.conv(F.interpolate(x, scale_factor=2, mode='bilinear', align_corners=False))

class MetalUNet_AttRes(nn.Module):
    def __init__(self, in_channels=1, out_channels=1, base=64, dropout=0.1, use_scse=True):
        super().__init__()
        self.enc1 = ResConvBlock(in_channels, base)
        self.enc2 = ResConvBlock(base, base*2)
        self.enc3 = ResConvBlock(base*2, base*4)
        self.enc4 = ResConvBlock(base*4, base*8)
        self.pool = nn.MaxPool2d(2)
        self.bottleneck = ResConvBlock(base*8, base*16, dropout=dropout)
        self.up4 = Up(base*16, base*8); self.att4 = AttentionGate(base*8, base*8, base*4)
        self.dec4 = ResConvBlock(base*16, base*8, dropout=dropout); self.scse4 = scSE(base*8) if use_scse else nn.Identity()
        self.up3 = Up(base*8, base*4); self.att3 = AttentionGate(base*4, base*4, base*2)
        self.dec3 = ResConvBlock(base*8, base*4, dropout=dropout); self.scse3 = scSE(base*4) if use_scse else nn.Identity()
        self.up2 = Up(base*4, base*2); self.att2 = AttentionGate(base*2, base*2, base)
        self.dec2 = ResConvBlock(base*4, base*2, dropout=dropout); self.scse2 = scSE(base*2) if use_scse else nn.Identity()
        self.up1 = Up(base*2, base);   self.att1 = AttentionGate(base, base, base//2)
        self.dec1 = ResConvBlock(base*2, base, dropout=dropout); self.scse1 = scSE(base) if use_scse else nn.Identity()
        self.final = nn.Conv2d(base, out_channels, 1)
    def forward(self, x):
        e1 = self.enc1(x)
        e2 = self.enc2(self.pool(e1))
        e3 = self.enc3(self.pool(e2))
        e4 = self.enc4(self.pool(e3))
        b  = self.bottleneck(self.pool(e4))
        d4 = self.up4(b);  d4 = torch.cat([self.att4(d4, e4), d4], 1); d4 = self.scse4(self.dec4(d4))
        d3 = self.up3(d4); d3 = torch.cat([self.att3(d3, e3), d3], 1); d3 = self.scse3(self.dec3(d3))
        d2 = self.up2(d3); d2 = torch.cat([self.att2(d2, e2), d2], 1); d2 = self.scse2(self.dec2(d2))
        d1 = self.up1(d2); d1 = torch.cat([self.att1(d1, e1), d1], 1); d1 = self.scse1(self.dec1(d1))
        return self.final(d1)

class MetalUNetPP(nn.Module):
    def __init__(self, encoder_name='timm-efficientnet-b4', encoder_weights='imagenet',
                 in_channels=1, classes=1, decoder_channels=(256,128,64,32,16), decoder_attention_type=None):
        super().__init__()
        if not _HAS_SMP:
            raise ImportError("Install segmentation-models-pytorch: pip install -U segmentation-models-pytorch timm")
        self.net = smp.UnetPlusPlus(
            encoder_name=encoder_name, encoder_weights=encoder_weights,
            in_channels=in_channels, classes=classes,
            decoder_channels=decoder_channels, decoder_attention_type=decoder_attention_type, activation=None
        )
    def forward(self, x): return self.net(x)

def build_unetpp_preset(preset: str = "effb4", in_channels: int = 1, classes: int = 1) -> nn.Module:
    preset = preset.lower()
    if preset == "effb4":
        return MetalUNetPP('timm-efficientnet-b4','imagenet',in_channels,classes,(256,128,64,32,16),None)
    elif preset == "effb7":
        return MetalUNetPP('timm-efficientnet-b7','imagenet',in_channels,classes,(192,96,48,24,12),None)
    elif preset == "resnet50":
        return MetalUNetPP('resnet50','imagenet',in_channels,classes,(256,128,64,32,16),'scse')
    elif preset == "convnext_base":
        return MetalUNetPP('timm-convnext_base','imagenet',in_channels,classes,(256,128,64,32,16),None)
    else:
        raise ValueError(f"Unknown preset '{preset}'")

# ========= Loss & metrics =========
class FocalDiceLoss(nn.Module):
    def __init__(self, alpha=0.8, gamma=2.0, smooth=1e-6):
        super().__init__(); self.alpha=alpha; self.gamma=gamma; self.smooth=smooth
        self.bce_logits = nn.BCEWithLogitsLoss(reduction='none')
    def forward(self, logits, targets):
        t = targets.float()
        bce = self.bce_logits(logits, t)
        p = torch.sigmoid(logits)
        p_t = t*p + (1-t)*(1-p)
        focal = (self.alpha * (1 - p_t).clamp_(1e-6).pow(self.gamma) * bce).mean()
        inter = (p*t).sum(dim=(1,2,3)); denom = p.sum(dim=(1,2,3)) + t.sum(dim=(1,2,3))
        dice = 1 - ((2*inter + self.smooth) / (denom + self.smooth)).mean()
        return focal + dice

@torch.no_grad()
def iou_from_logits(logits: torch.Tensor, targets: torch.Tensor, threshold: float = 0.5, eps: float = 1e-6) -> torch.Tensor:
    probs = torch.sigmoid(logits); preds = (probs > threshold).float(); t = targets.float()
    dims = tuple(range(2, preds.ndim)); inter = (preds * t).sum(dims); union = preds.sum(dims) + t.sum(dims) - inter
    return ((inter + eps) / (union + eps)).mean()

# ========= Pad/Unpad (stride-safe) =========
def _next_multiple(x, m=32): return (x + m - 1) // m * m

def pad_to_stride(x: torch.Tensor, stride: int = 32, mode: str = "reflect"):
    B,C,H,W = x.shape; Hn,Wn = _next_multiple(H,stride), _next_multiple(W,stride)
    ph,pw = Hn-H, Wn-W
    if ph==0 and pw==0: return x, (0,0,0,0)
    x_pad = F.pad(x, (0,pw,0,ph), mode=mode)  # (L,R,T,B)
    return x_pad, (0,ph,0,pw)

def unpad(x: torch.Tensor, pads):
    t,b,l,r = pads; H_pad,W_pad = x.shape[-2:]
    return x[..., t:H_pad-b if b>0 else None, l:W_pad-r if r>0 else None]

# ========= TTA inference (scale + pad→model→unpad) =========
@torch.no_grad()
def predict_with_tta(model, images, tta_scales=TTA_SCALES, stride=32):
    device = next(model.parameters()).device
    B,C,H,W = images.shape
    acc = torch.zeros((B,1,H,W), dtype=torch.float32, device=device)
    for s in tta_scales:
        if s == 1.0:
            im_s = images
        else:
            mode = 'bicubic' if s > 1.0 else 'area'
            im_s = F.interpolate(images, scale_factor=s, mode=mode, align_corners=False if mode!='area' else None)
        im_pad, pads = pad_to_stride(im_s, stride=stride, mode="reflect")
        logits_pad = model(im_pad)
        logits_s = unpad(logits_pad, pads)
        logits_native = F.interpolate(logits_s, size=(H,W), mode='bicubic', align_corners=False)
        acc += logits_native.float()
    return acc / float(len(tta_scales))

