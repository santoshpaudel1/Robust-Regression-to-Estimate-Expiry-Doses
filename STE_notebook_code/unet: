def soft_skeletonize(x, iters=8):
    # x: (B,1,H,W) in [0,1]
    for _ in range(iters):
        minpool = -F.max_pool2d(-x, kernel_size=3, stride=1, padding=1)
        contour = F.relu(x - minpool)
        x = F.relu(x - contour)
    return x

class CLDiceLoss(nn.Module):
    def __init__(self, smooth=1e-6, skel_iters=8):
        super().__init__()
        self.smooth = smooth
        self.skel_iters = skel_iters
    def forward(self, logits, targets):
        probs = torch.sigmoid(logits).clamp(1e-6, 1-1e-6)
        t = targets.float()
        skel_p = soft_skeletonize(probs, self.skel_iters)
        skel_t = soft_skeletonize(t, self.skel_iters)
        tprec = (skel_p * t).sum(dim=(1,2,3)) / (skel_p.sum(dim=(1,2,3)) + self.smooth)
        trec  = (skel_t * probs).sum(dim=(1,2,3)) / (skel_t.sum(dim=(1,2,3)) + self.smooth)
        cldice = 1.0 - (2*tprec*trec + self.smooth) / (tprec + trec + self.smooth)
        return cldice.mean()

class CompositeLoss(nn.Module):
    def __init__(self, bce_w=1.0, dice_w=1.0, cldice_w=1.0, smooth=1e-6, skel_iters=8):
        super().__init__()
        self.bce = nn.BCEWithLogitsLoss()
        self.cldice = CLDiceLoss(smooth=smooth, skel_iters=skel_iters)
        self.bce_w, self.dice_w, self.cldice_w = bce_w, dice_w, cldice_w
        self.smooth = smooth
    def forward(self, logits, targets):
        t = targets.float()
        bce = self.bce(logits, t)
        probs = torch.sigmoid(logits)
        inter = (probs * t).sum(dim=(1,2,3))
        denom = probs.sum(dim=(1,2,3)) + t.sum(dim=(1,2,3))
        dice = 1 - ((2*inter + self.smooth) / (denom + self.smooth)).mean()
        cld  = self.cldice(logits, t)
        return self.bce_w*bce + self.dice_w*dice + self.cldice_w*cld

class EdgeWeightedBCEDice(nn.Module):
    def __init__(self, edge_weight=3.0, smooth=1e-6):
        super().__init__()
        self.edge_weight = edge_weight
        self.smooth = smooth
        self.bce = nn.BCEWithLogitsLoss(reduction='none')
        kx = torch.tensor([[ 1, 0,-1],
                           [ 2, 0,-2],
                           [ 1, 0,-1]], dtype=torch.float32).view(1,1,3,3)
        ky = torch.tensor([[ 1, 2, 1],
                           [ 0, 0, 0],
                           [-1,-2,-1]], dtype=torch.float32).view(1,1,3,3)
        self.register_buffer('kx', kx)
        self.register_buffer('ky', ky)
    def forward(self, logits, targets):
        # match dtype/device under AMP
        t = targets.to(dtype=logits.dtype)
        kx = self.kx.to(device=t.device, dtype=t.dtype)
        ky = self.ky.to(device=t.device, dtype=t.dtype)
        edges_x = F.conv2d(t, kx, padding=1)
        edges_y = F.conv2d(t, ky, padding=1)
        edges = (edges_x.abs() + edges_y.abs()).clamp(0,1)
        w = 1.0 + self.edge_weight*edges
        bce = (self.bce(logits, t) * w).mean()
        probs = torch.sigmoid(logits)
        inter = (probs * t * w).sum(dim=(1,2,3))
        denom = (probs*w).sum(dim=(1,2,3)) + (t*w).sum(dim=(1,2,3))
        dice = 1 - ((2*inter + self.smooth) / (denom + self.smooth)).mean()
        return bce + dice

