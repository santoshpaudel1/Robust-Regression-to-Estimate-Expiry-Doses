# -------------------- PAD/UNPAD HELPERS (stride-safe) --------------------
def _next_multiple(x, m=32):
    return (x + m - 1) // m * m

def pad_to_stride(x: torch.Tensor, stride: int = 32, mode: str = "reflect"):
    """
    x: (B,C,H,W) -> returns (x_pad, pads) where pads=(top,bottom,left,right)
    """
    B, C, H, W = x.shape
    Hn, Wn = _next_multiple(H, stride), _next_multiple(W, stride)
    pad_h, pad_w = Hn - H, Wn - W
    pads_f = (0, pad_w, 0, pad_h)  # (left,right,top,bottom) for F.pad
    if pad_h == 0 and pad_w == 0:
        return x, (0, 0, 0, 0)
    x_pad = F.pad(x, pads_f, mode=mode)
    return x_pad, (0, pad_h, 0, pad_w)

def unpad(x: torch.Tensor, pads):
    """
    x: (B,C,H_pad,W_pad), pads=(top,bottom,left,right) -> crop back
    """
    t, b, l, r = pads
    H_pad, W_pad = x.shape[-2:]
    return x[..., t:H_pad - b if b > 0 else None, l:W_pad - r if r > 0 else None]

# -------------------- TTA Inference (stride-safe) --------------------
@torch.no_grad()
def predict_with_tta(model, images, tta_scales=TTA_SCALES, stride=32):
    """
    images: (B,1,H,W) float32 [0,1]; returns averaged logits at native (H,W).
    Pads to multiples of `stride` so SMP encoders are happy for arbitrary scales.
    """
    device = next(model.parameters()).device
    B, C, H, W = images.shape
    acc = torch.zeros((B,1,H,W), dtype=torch.float32, device=device)

    for s in tta_scales:
        # scale
        if s == 1.0:
            im_s = images
        else:
            mode = 'bicubic' if s > 1.0 else 'area'
            im_s = F.interpolate(images, scale_factor=s, mode=mode,
                                 align_corners=False if mode != 'area' else None)

        # pad to stride
        im_s_pad, pads = pad_to_stride(im_s, stride=stride, mode="reflect")

        # forward
        logits_s_pad = model(im_s_pad)

        # unpad back to scaled size
        logits_s = unpad(logits_s_pad, pads)

        # resize back to native HxW
        logits_native = F.interpolate(logits_s, size=(H, W), mode='bicubic', align_corners=False)
        acc += logits_native.float()

    return acc / float(len(tta_scales))

@torch.no_grad()
def iou_from_logits(logits: torch.Tensor, targets: torch.Tensor,
                    threshold: float = 0.5, eps: float = 1e-6) -> torch.Tensor:
    probs = torch.sigmoid(logits)
    preds = (probs > threshold).float()
    t = targets.float()
    dims = tuple(range(2, preds.ndim))
    inter = (preds * t).sum(dims)
    union = preds.sum(dims) + t.sum(dims) - inter
    return ((inter + eps) / (union + eps)).mean()

# -------------------- Train/Eval Loops --------------------
def train_one_epoch(model, loader, device):
    model.train()
    running = 0.0
    for images, masks in loader:
        images = images.to(device, non_blocking=True)
        masks  = masks.to(device, non_blocking=True)

        optimizer.zero_grad(set_to_none=True)
        with torch.autocast(
            device_type='cuda',
            dtype=(torch.bfloat16 if torch.cuda.is_bf16_supported() else torch.float16),
            enabled=torch.cuda.is_available() and MIXED_PRECISION
        ):
            logits = model(images)
        loss = total_loss_fn(logits, masks)

        scaler.scale(loss).backward()
        scaler.step(optimizer)
        scaler.update()

        running += loss.item() * images.size(0)
    return running / len(loader.dataset)

@torch.no_grad()
def validate(model, loader, device):
    model.eval()
    val_loss = 0.0
    val_iou  = 0.0
    for images, masks in loader:
        images = images.to(device, non_blocking=True)
        masks  = masks.to(device, non_blocking=True)
        with torch.autocast(
            device_type='cuda',
            dtype=(torch.bfloat16 if torch.cuda.is_bf16_supported() else torch.float16),
            enabled=torch.cuda.is_available() and MIXED_PRECISION
        ):
            logits = predict_with_tta(model, images, tta_scales=TTA_SCALES, stride=32)
        loss = total_loss_fn(logits, masks)
        val_loss += loss.item() * images.size(0)
        val_iou  += iou_from_logits(logits, masks, threshold=0.5).item() * images.size(0)

    n = len(loader.dataset)
    return val_loss / n, val_iou / n

