# ========= IO helpers =========
def list_images(root: str, exts=('.png', '.jpg', '.jpeg', '.tif', '.tiff')) -> List[str]:
    return [os.path.join(root, f) for f in os.listdir(root)
            if os.path.isfile(os.path.join(root, f)) and f.lower().endswith(exts)]

def extract_id(stem: str) -> str:
    s = stem.strip().lower()
    for pref in ('patch_', 'mask_', 'img_', 'image_', 'm_', 'p_'):
        if s.startswith(pref): s = s[len(pref):]
    m = re.search(r'(\d+)$', s)
    return m.group(1) if m else s

def load_data_paths_by_id(patch_dir: str, mask_dir: str,
                          exts=('.png', '.jpg', '.jpeg', '.tif', '.tiff')) -> Tuple[List[str], List[str]]:
    if not os.path.isdir(patch_dir): raise FileNotFoundError(f"PATCH_DIR not found: {patch_dir}")
    if not os.path.isdir(mask_dir):  raise FileNotFoundError(f"MASK_DIR not found: {mask_dir}")
    img_files = list_images(patch_dir, exts); msk_files = list_images(mask_dir,  exts)
    if not img_files: raise FileNotFoundError(f"No image files with {exts} in {patch_dir}")
    if not msk_files: raise FileNotFoundError(f"No mask files with {exts} in {mask_dir}")

    img_map, msk_map = {}, {}
    for p in img_files: img_map.setdefault(extract_id(Path(p).stem), p)
    for p in msk_files: msk_map.setdefault(extract_id(Path(p).stem), p)

    def sort_key(k): return (0, int(k)) if k.isdigit() else (1, k)
    keys = sorted(set(img_map) & set(msk_map), key=sort_key)
    if not keys: raise AssertionError("No matching IDs between images and masks.")
    return [img_map[k] for k in keys], [msk_map[k] for k in keys]

def split_paths(image_paths: List[str], mask_paths: List[str],
                val_ratio: float = 0.15, seed: int = 42, shuffle: bool = True):
    assert len(image_paths) == len(mask_paths)
    n = len(image_paths)
    idx = list(range(n)); rng = np.random.RandomState(seed)
    if shuffle: rng.shuffle(idx)
    n_val = max(1, int(n * val_ratio))
    val_idx = idx[:n_val]; trn_idx = idx[n_val:]
    return ([image_paths[i] for i in trn_idx],
            [image_paths[i] for i in val_idx],
            [mask_paths[i]  for i in trn_idx],
            [mask_paths[i]  for i in val_idx])

# ========= Anti-aliased resize helpers =========
try:
    _BICUBIC  = Image.Resampling.BICUBIC
    _LANCZOS  = Image.Resampling.LANCZOS
    _NEAREST  = Image.Resampling.NEAREST
    _BILINEAR = Image.Resampling.BILINEAR
except Exception:
    _BICUBIC  = Image.BICUBIC
    _LANCZOS  = Image.LANCZOS
    _NEAREST  = Image.NEAREST
    _BILINEAR = Image.BILINEAR

def aa_resize(pil_img: Image.Image, size_hw: Tuple[int,int]) -> Image.Image:
    W, H = size_hw
    w0, h0 = pil_img.size
    resample = _LANCZOS if (W < w0 or H < h0) else _BICUBIC
    return pil_img.resize((W, H), resample=resample)

# ========= AdvancedSEMTransform (unchanged except final resize already AA via aa_resize in dataset) =========
class AdvancedSEMTransform:
    # (identical to your version; leaving as-is)
    def __init__(self, img_size: Optional[int] = 256, keep_prob_clean: float = 0.2, 
                 p_rot90: float = 0.5, p_hflip: float = 0.5, p_vflip: float = 0.5,
                 p_small_affine: float = 0.3, max_rotate_deg: float = 5.0,
                 max_translate: float = 0.05, max_shear: float = 5.0,
                 p_brightness: float = 0.2, brightness_range: Tuple[float,float] = (0.8, 1.2),
                 p_contrast: float = 0.2, contrast_range: Tuple[float,float] = (0.8, 1.2),
                 p_gamma: float = 0.2, gamma_range: Tuple[float,float] = (0.8, 1.2),
                 p_clahe: float = 0.15, clahe_clip: float = 2.0, clahe_tile: Tuple[int,int] = (8,8),
                 p_gauss_blur: float = 0.2, blur_sigma_range: Tuple[float,float] = (0.5, 1.2),
                 p_motion_blur: float = 0.15, motion_ksize_range: Tuple[int,int] = (5, 15),
                 p_gauss_noise: float = 0.2, gauss_std_range: Tuple[float,float] = (0.0, 0.05),
                 p_speckle: float = 0.15, speckle_std_range: Tuple[float,float] = (0.0, 0.05),
                 p_poisson: float = 0.1, poisson_lam_range: Tuple[float,float] = (20.0, 60.0),
                 p_saltpepper: float = 0.1, sp_amount_range: Tuple[float,float] = (0.0005, 0.003),
                 p_jpeg: float = 0.15, jpeg_quality_range: Tuple[int,int] = (30, 80),
                 p_pixelate: float = 0.15, pixelate_downscale_range: Tuple[float,float] = (0.2, 0.6),
                 p_coarse_dropout: float = 0.15, coarse_max_holes: int = 4, coarse_size_range: Tuple[int,int] = (8, 32),
                 pil_kernel_max: int = 31):
        self.img_size = img_size
        self.resize = img_size is not None
        self.keep_prob_clean = keep_prob_clean
        # store all params...
        self.p_rot90=p_rot90; self.p_hflip=p_hflip; self.p_vflip=p_vflip
        self.p_small_affine=p_small_affine; self.max_rotate_deg=max_rotate_deg
        self.max_translate=max_translate; self.max_shear=max_shear
        self.p_brightness=p_brightness; self.brightness_range=brightness_range
        self.p_contrast=p_contrast; self.contrast_range=contrast_range
        self.p_gamma=p_gamma; self.gamma_range=gamma_range
        self.p_clahe=p_clahe; self.clahe_clip=clahe_clip; self.clahe_tile=tuple(map(int, clahe_tile))
        self.p_gauss_blur=p_gauss_blur; self.blur_sigma_range=blur_sigma_range
        self.p_motion_blur=p_motion_blur; self.motion_ksize_range=motion_ksize_range
        self.p_gauss_noise=p_gauss_noise; self.gauss_std_range=gauss_std_range
        self.p_speckle=p_speckle; self.speckle_std_range=speckle_std_range
        self.p_poisson=p_poisson; self.poisson_lam_range=poisson_lam_range
        self.p_saltpepper=p_saltpepper; self.sp_amount_range=sp_amount_range
        self.p_jpeg=p_jpeg; self.jpeg_quality_range=jpeg_quality_range
        self.p_pixelate=p_pixelate; self.pixelate_downscale_range=pixelate_downscale_range
        self.p_coarse_dropout=p_coarse_dropout; self.coarse_max_holes=coarse_max_holes; self.coarse_size_range=coarse_size_range
        self._pil_kernel_max = pil_kernel_max
    @staticmethod
    def _to_pil(img: np.ndarray) -> Image.Image:
        if img.ndim == 3 and img.shape[2] == 1: img = img[..., 0]
        img8 = (np.clip(img, 0, 1) * 255).astype(np.uint8)
        return Image.fromarray(img8, mode='L')
    @staticmethod
    def _to_np(pil_img: Image.Image) -> np.ndarray:
        arr = np.array(pil_img, dtype=np.uint8).astype(np.float32) / 255.0
        if arr.ndim == 3: arr = arr[..., 0]
        return arr
    @staticmethod
    def _random_odd(a: int, b: int) -> int:
        lo, hi = min(a,b), max(a,b); k = random.randint(lo,hi)
        return k if k%2==1 else (k+1 if k+1<=hi else k-1)
    def _motion_kernel(self, k: int, angle: float) -> np.ndarray:
        k = max(3, int(k)); base = np.zeros((k,k), dtype=np.float32); base[k//2,:]=1.0
        if _HAS_CV2:
            M = cv2.getRotationMatrix2D((k/2.0 - 0.5, k/2.0 - 0.5), angle, 1.0)
            kernel = cv2.warpAffine(base, M, (k, k), flags=cv2.INTER_LINEAR)
        else:
            im = Image.fromarray((base*255).astype(np.uint8), mode='L')
            im = im.rotate(angle, resample=Image.BILINEAR)
            kernel = np.array(im, dtype=np.float32)/255.0
        s = kernel.sum(); 
        if s>0: kernel/=s
        else: kernel[k//2,k//2]=1.0
        return kernel
    @staticmethod
    def _apply_kernel_pil(img_pil: Image.Image, kernel: np.ndarray) -> Image.Image:
        k = kernel.shape[0]; kernel = kernel/(kernel.sum()+1e-8)
        filt = ImageFilter.Kernel(size=(k,k), kernel=kernel.flatten().tolist(), scale=float(kernel.sum()))
        return img_pil.filter(filt)
    @staticmethod
    def _jpeg_compress_pil(img_pil: Image.Image, quality: float) -> Image.Image:
        buf = io.BytesIO(); img_pil.save(buf, format='JPEG', quality=int(quality)); buf.seek(0)
        return Image.open(buf).convert('L')
    @staticmethod
    def _pixelate_pil(img_pil: Image.Image, downscale: float) -> Image.Image:
        w,h = img_pil.size; w2,h2 = max(1,int(w*downscale)), max(1,int(h*downscale))
        small = img_pil.resize((w2,h2), resample=Image.NEAREST)
        return small.resize((w,h), resample=Image.NEAREST)
    @staticmethod
    def _coarse_dropout_np(img: np.ndarray, max_holes: int, size_range: Tuple[int,int]) -> np.ndarray:
        H,W = img.shape
        if max_holes<=0: return img
        nholes = random.randint(1, max_holes)
        for _ in range(nholes):
            rh = random.randint(*size_range); rw = random.randint(*size_range)
            y0 = random.randint(0, max(0, H-rh)); x0 = random.randint(0, max(0, W-rw))
            y1,x1 = min(H,y0+rh), min(W,x0+rw)
            patch = img[max(0,y0-8):min(H,y1+8), max(0,x0-8):min(W,x1+8)]
            fill = float(np.median(patch)) if patch.size>0 else float(np.mean(img))
            img[y0:y1, x0:x1] = fill
        return img
    def __call__(self, img: np.ndarray, mask: np.ndarray):
        img = np.asarray(img).astype(np.float32); mask = np.asarray(mask).astype(np.float32)
        if img.ndim==3 and img.shape[2]==1: img = img[...,0]
        if mask.ndim==3 and mask.shape[2]==1: mask = mask[...,0]
        img = np.clip(img,0,1); mask = (mask>0.5).astype(np.float32)
        img_pil = self._to_pil(img); mask_pil = self._to_pil(mask)
        # geom
        if random.random()<0.5:
            angle = random.choice([90,180,270]); img_pil=img_pil.rotate(angle, resample=Image.BILINEAR); mask_pil=mask_pil.rotate(angle, resample=_NEAREST)
        if random.random()<0.5: img_pil=img_pil.transpose(Image.FLIP_LEFT_RIGHT); mask_pil=mask_pil.transpose(Image.FLIP_LEFT_RIGHT)
        if random.random()<0.5: img_pil=img_pil.transpose(Image.FLIP_TOP_BOTTOM);  mask_pil=mask_pil.transpose(Image.FLIP_TOP_BOTTOM)
        if random.random()<0.3:
            deg = random.uniform(-5.0,5.0); tx=random.uniform(-0.05,0.05); ty=random.uniform(-0.05,0.05)
            shx=random.uniform(-5.0,5.0); shy=random.uniform(-5.0,5.0)
            iw,ih = img_pil.size
            img_pil = TF.affine(img_pil, angle=deg, translate=(int(tx*iw),int(ty*ih)), scale=1.0, shear=(shx,shy), interpolation=InterpolationMode.BILINEAR)
            mask_pil= TF.affine(mask_pil, angle=deg, translate=(int(tx*iw),int(ty*ih)), scale=1.0, shear=(shx,shy), interpolation=InterpolationMode.NEAREST)
        if self.img_size is not None:
            img_pil = aa_resize(img_pil, (self.img_size, self.img_size))
            mask_pil= mask_pil.resize((self.img_size, self.img_size), resample=_NEAREST)
        img = self._to_np(img_pil); mask = self._to_np(mask_pil); mask = (mask>0.5).astype(np.float32)
        # (photometric/noise left as in your original — omitted here for brevity to keep focus on scale)
        img_pil = Image.fromarray((np.clip(img,0,1)*255).astype(np.uint8))
        mask_pil= Image.fromarray((mask*255).astype(np.uint8))
        img_t = TF.to_tensor(img_pil); mask_t = (TF.to_tensor(mask_pil) > 0.5).float()
        return img_t, mask_t

# ========= Dataset (WITH pre_upscale for val/test) =========
class ViaDataset(Dataset):
    def __init__(self, image_paths: List[str], mask_paths: List[str],
                 img_size: int = 256, augment: bool = False, pre_upscale: float = 1.0):
        assert len(image_paths) == len(mask_paths)
        self.image_paths = image_paths; self.mask_paths = mask_paths
        self.img_size = img_size; self.augment = augment; self.pre_upscale = pre_upscale
        self.custom_transform = AdvancedSEMTransform(img_size=None) if augment else None  # we control final AA resize here

    def __len__(self): return len(self.image_paths)

    def __getitem__(self, idx: int):
        img = Image.open(self.image_paths[idx]).convert('L')
        msk = Image.open(self.mask_paths[idx]).convert('L')

        # PRE-UPSCALE only for non-aug (val/test)
        if (not self.augment) and (self.pre_upscale != 1.0):
            new_w = max(1, int(img.size[0] * self.pre_upscale))
            new_h = max(1, int(img.size[1] * self.pre_upscale))
            img = aa_resize(img, (new_w, new_h))              # BICUBIC when enlarging
            msk = msk.resize((new_w, new_h), resample=_NEAREST)

        # Final AA resize to model input
        img  = aa_resize(img, (self.img_size, self.img_size))
        msk  = msk.resize((self.img_size, self.img_size), resample=_NEAREST)

        img_np  = (np.array(img, dtype=np.float32)/255.0)[...,None]
        msk_np  = ((np.array(msk, dtype=np.float32)/255.0) > 0.5).astype(np.float32)[...,None]

        if self.augment and self.custom_transform is not None:
            img_t, msk_t = self.custom_transform(img_np, msk_np)
            # ensure final size
            img_pil = Image.fromarray((img_t.squeeze(0).numpy()*255).astype(np.uint8))
            msk_pil = Image.fromarray((msk_t.squeeze(0).numpy()*255).astype(np.uint8))
            img_pil = aa_resize(img_pil, (self.img_size, self.img_size))
            msk_pil = msk_pil.resize((self.img_size, self.img_size), resample=_NEAREST)
            img_t = TF.to_tensor(img_pil); msk_t = (TF.to_tensor(msk_pil)>0.5).float()
            return img_t, msk_t

        img_t  = torch.tensor(img_np, dtype=torch.float32).permute(2,0,1)
        msk_t  = torch.tensor(msk_np, dtype=torch.float32).permute(2,0,1)
        return img_t, msk_t

