class AdvancedSEMTransform:
    """
    Synchronized geometry + photometric corruptions for grayscale SEM (image & mask).
    Returns torch tensors: (img_t, mask_t) shapes (1,H,W), image in [0,1], mask in {0,1}.
    """
    def __init__(
        self,
        img_size: Optional[int] = 256,
        keep_prob_clean: float = 0.2,

        # Geometric
        p_rot90: float = 0.5,
        p_hflip: float = 0.5,
        p_vflip: float = 0.5,
        p_small_affine: float = 0.3,
        max_rotate_deg: float = 5.0,
        max_translate: float = 0.05,   # fraction
        max_shear: float = 5.0,        # degrees

        # Photometric
        p_brightness: float = 0.2, brightness_range: Tuple[float,float] = (0.8, 1.2),
        p_contrast: float = 0.2,   contrast_range: Tuple[float,float] = (0.8, 1.2),
        p_gamma: float = 0.2,      gamma_range: Tuple[float,float] = (0.8, 1.2),
        p_clahe: float = 0.15,     clahe_clip: float = 2.0, clahe_tile: Tuple[int,int] = (8,8),

        # Blur
        p_gauss_blur: float = 0.2, blur_sigma_range: Tuple[float,float] = (0.5, 1.2),
        p_motion_blur: float = 0.15, motion_ksize_range: Tuple[int,int] = (5, 15),

        # Noise
        p_gauss_noise: float = 0.2, gauss_std_range: Tuple[float,float] = (0.0, 0.05),
        p_speckle: float = 0.15,     speckle_std_range: Tuple[float,float] = (0.0, 0.05),
        p_poisson: float = 0.1,      poisson_lam_range: Tuple[float,float] = (20.0, 60.0),
        p_saltpepper: float = 0.1,   sp_amount_range: Tuple[float,float] = (0.0005, 0.003),

        # Compression / pixelation / dropout
        p_jpeg: float = 0.15,           jpeg_quality_range: Tuple[int,int] = (30, 80),
        p_pixelate: float = 0.15,       pixelate_downscale_range: Tuple[float,float] = (0.2, 0.6),
        p_coarse_dropout: float = 0.15, coarse_max_holes: int = 4, coarse_size_range: Tuple[int,int] = (8, 32),

        pil_kernel_max: int = 31
    ):
        self.img_size = img_size
        self.resize = img_size is not None

        self.keep_prob_clean = keep_prob_clean

        # Geom
        self.p_rot90 = p_rot90
        self.p_hflip = p_hflip
        self.p_vflip = p_vflip
        self.p_small_affine = p_small_affine
        self.max_rotate_deg = max_rotate_deg
        self.max_translate = max_translate
        self.max_shear = max_shear

        # Photometric
        self.p_brightness = p_brightness
        self.brightness_range = brightness_range
        self.p_contrast = p_contrast
        self.contrast_range = contrast_range
        self.p_gamma = p_gamma
        self.gamma_range = gamma_range
        self.p_clahe = p_clahe
        self.clahe_clip = clahe_clip
        self.clahe_tile = tuple(map(int, clahe_tile))

        # Blur
        self.p_gauss_blur = p_gauss_blur
        self.blur_sigma_range = blur_sigma_range
        self.p_motion_blur = p_motion_blur
        self.motion_ksize_range = motion_ksize_range
        self._pil_kernel_max = pil_kernel_max

        # Noise
        self.p_gauss_noise = p_gauss_noise
        self.gauss_std_range = gauss_std_range
        self.p_speckle = p_speckle
        self.speckle_std_range = speckle_std_range
        self.p_poisson = p_poisson
        self.poisson_lam_range = poisson_lam_range
        self.p_saltpepper = p_saltpepper
        self.sp_amount_range = sp_amount_range

        # Compression / pixelation / dropout
        self.p_jpeg = p_jpeg
        self.jpeg_quality_range = jpeg_quality_range
        self.p_pixelate = p_pixelate
        self.pixelate_downscale_range = pixelate_downscale_range
        self.p_coarse_dropout = p_coarse_dropout
        self.coarse_max_holes = coarse_max_holes
        self.coarse_size_range = coarse_size_range

    # ---- helpers ----
    @staticmethod
    def _to_pil(img: np.ndarray) -> Image.Image:
        if img.ndim == 3 and img.shape[2] == 1:
            img = img[..., 0]
        img8 = (np.clip(img, 0, 1) * 255).astype(np.uint8)
        return Image.fromarray(img8, mode='L')

    @staticmethod
    def _to_np(pil_img: Image.Image) -> np.ndarray:
        arr = np.array(pil_img, dtype=np.uint8).astype(np.float32) / 255.0
        if arr.ndim == 3:
            arr = arr[..., 0]
        return arr

    @staticmethod
    def _random_odd(a: int, b: int) -> int:
        lo, hi = min(a, b), max(a, b)
        k = random.randint(lo, hi)
        return k if k % 2 == 1 else (k + 1 if k + 1 <= hi else k - 1)

    def _motion_kernel(self, k: int, angle: float) -> np.ndarray:
        k = max(3, int(k))
        base = np.zeros((k, k), dtype=np.float32)
        base[k // 2, :] = 1.0  # horizontal line

        if _HAS_CV2:
            M = cv2.getRotationMatrix2D((k / 2.0 - 0.5, k / 2.0 - 0.5), angle, 1.0)
            kernel = cv2.warpAffine(base, M, (k, k), flags=cv2.INTER_LINEAR)
        else:
            im = Image.fromarray((base * 255).astype(np.uint8), mode='L')
            im = im.rotate(angle, resample=Image.BILINEAR)
            kernel = np.array(im, dtype=np.float32) / 255.0

        s = kernel.sum()
        if s > 0:
            kernel /= s
        else:
            kernel[k // 2, k // 2] = 1.0
        return kernel

    @staticmethod
    def _apply_kernel_pil(img_pil: Image.Image, kernel: np.ndarray) -> Image.Image:
        k = kernel.shape[0]
        kernel = kernel / (kernel.sum() + 1e-8)
        filt = ImageFilter.Kernel(
            size=(k, k),
            kernel=kernel.flatten().tolist(),
            scale=sum(kernel.flatten().tolist()) or 1.0
        )
        return img_pil.filter(filt)

    @staticmethod
    def _jpeg_compress_pil(img_pil: Image.Image, quality: float) -> Image.Image:
        buf = io.BytesIO()
        img_pil.save(buf, format='JPEG', quality=int(quality))
        buf.seek(0)
        return Image.open(buf).convert('L')

    @staticmethod
    def _pixelate_pil(img_pil: Image.Image, downscale: float) -> Image.Image:
        w, h = img_pil.size
        w2, h2 = max(1, int(w * downscale)), max(1, int(h * downscale))
        small = img_pil.resize((w2, h2), resample=Image.NEAREST)
        return small.resize((w, h), resample=Image.NEAREST)

    @staticmethod
    def _coarse_dropout_np(img: np.ndarray, max_holes: int, size_range: Tuple[int,int]) -> np.ndarray:
        H, W = img.shape
        if max_holes <= 0:
            return img
        nholes = random.randint(1, max_holes)
        for _ in range(nholes):
            rh = random.randint(size_range[0], size_range[1])
            rw = random.randint(size_range[0], size_range[1])
            y0 = random.randint(0, max(0, H - rh))
            x0 = random.randint(0, max(0, W - rw))
            y1, x1 = min(H, y0 + rh), min(W, x0 + rw)
            patch = img[max(0, y0 - 8):min(H, y1 + 8), max(0, x0 - 8):min(W, x1 + 8)]
            fill = float(np.median(patch)) if patch.size > 0 else float(np.mean(img))
            img[y0:y1, x0:x1] = fill
        return img

    # ------------- main -------------
    def __call__(self, img: np.ndarray, mask: np.ndarray):
        # Ensure shapes & ranges
        img = np.asarray(img).astype(np.float32)
        mask = np.asarray(mask).astype(np.float32)
        if img.ndim == 3 and img.shape[2] == 1: img = img[..., 0]
        if mask.ndim == 3 and mask.shape[2] == 1: mask = mask[..., 0]
        img = np.clip(img, 0, 1)
        mask = (mask > 0.5).astype(np.float32)

        # PIL for synchronized geometry
        img_pil = self._to_pil(img)
        mask_pil = self._to_pil(mask)

        # Geometric transforms
        if random.random() < self.p_rot90:
            angle = random.choice([90, 180, 270])  # ensure effect
            img_pil  = img_pil.rotate(angle, resample=Image.BILINEAR)
            mask_pil = mask_pil.rotate(angle, resample=Image.NEAREST)

        if random.random() < self.p_hflip:
            img_pil  = img_pil.transpose(Image.FLIP_LEFT_RIGHT)
            mask_pil = mask_pil.transpose(Image.FLIP_LEFT_RIGHT)

        if random.random() < self.p_vflip:
            img_pil  = img_pil.transpose(Image.FLIP_TOP_BOTTOM)
            mask_pil = mask_pil.transpose(Image.FLIP_TOP_BOTTOM)

        if random.random() < self.p_small_affine:
            deg = random.uniform(-self.max_rotate_deg, self.max_rotate_deg)
            tx = random.uniform(-self.max_translate, self.max_translate)
            ty = random.uniform(-self.max_translate, self.max_translate)
            shx = random.uniform(-self.max_shear, self.max_shear)
            shy = random.uniform(-self.max_shear, self.max_shear)

            iw, ih = img_pil.size
            img_pil = TF.affine(
                img_pil, angle=deg,
                translate=(int(tx * iw), int(ty * ih)),
                scale=1.0, shear=(shx, shy),
                interpolation=InterpolationMode.BILINEAR
            )
            mask_pil = TF.affine(
                mask_pil, angle=deg,
                translate=(int(tx * iw), int(ty * ih)),
                scale=1.0, shear=(shx, shy),
                interpolation=InterpolationMode.NEAREST
            )

        # Resize
        if self.resize and self.img_size is not None:
            img_pil  = img_pil.resize((self.img_size, self.img_size), resample=Image.BILINEAR)
            mask_pil = mask_pil.resize((self.img_size, self.img_size), resample=Image.NEAREST)

        # Pixel-level
        img = self._to_np(img_pil)
        mask = self._to_np(mask_pil)
        mask = (mask > 0.5).astype(np.float32)

        # Photometric & degradation
        if random.random() > self.keep_prob_clean:
            # Brightness/contrast/gamma
            if random.random() < self.p_brightness:
                factor = random.uniform(*self.brightness_range)
                img_pil = Image.fromarray((img * 255).astype(np.uint8))
                img_pil = ImageEnhance.Brightness(img_pil).enhance(factor)
                img = self._to_np(img_pil)

            if random.random() < self.p_contrast:
                factor = random.uniform(*self.contrast_range)
                img_pil = Image.fromarray((img * 255).astype(np.uint8))
                img_pil = ImageEnhance.Contrast(img_pil).enhance(factor)
                img = self._to_np(img_pil)

            if random.random() < self.p_gamma:
                gamma = random.uniform(*self.gamma_range)
                img = np.power(np.clip(img, 0, 1), gamma)

            # CLAHE
            if self.p_clahe and random.random() < self.p_clahe:
                u8 = (np.clip(img, 0, 1) * 255).astype(np.uint8)
                if _HAS_CV2:
                    clahe = cv2.createCLAHE(clipLimit=self.clahe_clip, tileGridSize=self.clahe_tile)
                    u8 = clahe.apply(u8)
                else:
                    u8 = np.array(Image.fromarray(u8).filter(ImageFilter.SMOOTH))
                img = u8.astype(np.float32) / 255.0

            # Blur
            if random.random() < self.p_gauss_blur:
                sigma = random.uniform(*self.blur_sigma_range)
                img_pil = Image.fromarray((img * 255).astype(np.uint8))
                img_pil = img_pil.filter(ImageFilter.GaussianBlur(radius=sigma))
                img = self._to_np(img_pil)

            if random.random() < self.p_motion_blur:
                k = self._random_odd(*self.motion_ksize_range)
                angle = random.choice([0, 30, 60, 90, 120, 150])
                kernel = self._motion_kernel(min(k, self._pil_kernel_max), angle)
                if _HAS_CV2:
                    u8 = (np.clip(img, 0, 1) * 255).astype(np.uint8)
                    blurred = cv2.filter2D(u8, -1, kernel, borderType=cv2.BORDER_REPLICATE)
                    img = blurred.astype(np.float32) / 255.0
                else:
                    img_pil = Image.fromarray((np.clip(img, 0, 1) * 255).astype(np.uint8))
                    img_pil = self._apply_kernel_pil(img_pil, kernel)
                    img = self._to_np(img_pil)

            # Noise
            if random.random() < self.p_gauss_noise:
                std = random.uniform(*self.gauss_std_range)
                img = img + np.random.normal(0.0, std, img.shape).astype(np.float32)

            if random.random() < self.p_speckle:
                std = random.uniform(*self.speckle_std_range)
                img = img * (1.0 + np.random.normal(0.0, std, img.shape).astype(np.float32))

            if random.random() < self.p_poisson:
                lam = random.uniform(*self.poisson_lam_range)
                scaled = np.clip(img, 0, 1) * lam
                noisy = np.random.poisson(scaled).astype(np.float32)
                img = noisy / max(lam, 1e-6)

            if random.random() < self.p_saltpepper:
                amount = random.uniform(*self.sp_amount_range)
                H, W = img.shape
                num = int(amount * H * W)
                ys = np.random.randint(0, H, num)
                xs = np.random.randint(0, W, num)
                img[ys, xs] = 1.0
                ys = np.random.randint(0, H, num)
                xs = np.random.randint(0, W, num)
                img[ys, xs] = 0.0

            # Compression / pixelation / dropout
            if random.random() < self.p_jpeg:
                q = random.uniform(*self.jpeg_quality_range)
                img_pil = Image.fromarray((np.clip(img, 0, 1) * 255).astype(np.uint8))
                img_pil = self._jpeg_compress_pil(img_pil, q)
                img = self._to_np(img_pil)

            if random.random() < self.p_pixelate:
                factor = random.uniform(*self.pixelate_downscale_range)
                img_pil = Image.fromarray((np.clip(img, 0, 1) * 255).astype(np.uint8))
                img_pil = self._pixelate_pil(img_pil, factor)
                img = self._to_np(img_pil)

            if random.random() < self.p_coarse_dropout:
                img = self._coarse_dropout_np(img, self.coarse_max_holes, self.coarse_size_range)

            img = np.clip(img, 0.0, 1.0)

        # To tensors
        img_pil = Image.fromarray((img * 255).astype(np.uint8))
        mask_pil = Image.fromarray((mask * 255).astype(np.uint8))
        img_t = TF.to_tensor(img_pil)   # (1,H,W)
        mask_t = TF.to_tensor(mask_pil)
        mask_t = (mask_t > 0.5).float()
        return img_t, mask_t


class ViaDataset(Dataset):
    def __init__(self, image_paths: List[str], mask_paths: List[str],
                 img_size: int = 256, augment: bool = False):
        assert len(image_paths) == len(mask_paths), "Image/Mask count mismatch"
        self.image_paths = image_paths
        self.mask_paths = mask_paths
        self.img_size = img_size
        self.augment = augment
        self.custom_transform = AdvancedSEMTransform(img_size=img_size) if augment else None

    def __len__(self):
        return len(self.image_paths)

    def __getitem__(self, idx: int):
        img = Image.open(self.image_paths[idx]).convert('L')
        mask = Image.open(self.mask_paths[idx]).convert('L')

        img  = img.resize((self.img_size, self.img_size), resample=Image.BILINEAR)
        mask = mask.resize((self.img_size, self.img_size), resample=Image.NEAREST)

        img_np  = np.array(img, dtype=np.float32) / 255.0
        mask_np = np.array(mask, dtype=np.float32) / 255.0
        mask_np = (mask_np > 0.5).astype(np.float32)

        img_np  = np.expand_dims(img_np, axis=-1)
        mask_np = np.expand_dims(mask_np, axis=-1)

        if self.augment and self.custom_transform:
            img_t, mask_t = self.custom_transform(img_np, mask_np)
        else:
            img_t  = torch.tensor(img_np, dtype=torch.float32).permute(2, 0, 1)
            mask_t = torch.tensor(mask_np, dtype=torch.float32).permute(2, 0, 1)

        return img_t, mask_t


def load_data_paths(patch_dir: str, mask_dir: str) -> Tuple[List[str], List[str]]:
    imgs = [f for f in os.listdir(patch_dir) if f.lower().endswith('.png')]
    msks = [f for f in os.listdir(mask_dir) if f.lower().endswith('.png')]
    img_map = {Path(p).stem: os.path.join(patch_dir, p) for p in imgs}
    msk_map = {Path(p).stem: os.path.join(mask_dir, p) for p in msks}
    keys = sorted(set(img_map) & set(msk_map))
    assert keys, "No matching image/mask stems found."
    image_paths = [img_map[k] for k in keys]
    mask_paths  = [msk_map[k] for k in keys]
    return image_paths, mask_paths


def split_paths(image_paths: List[str], mask_paths: List[str],
                val_ratio: float = 0.15, seed: int = 42, shuffle: bool = True):
    n = len(image_paths)
    idx = list(range(n))
    rnd = random.Random(seed)
    if shuffle:
        rnd.shuffle(idx)
    n_val = max(1, int(n * val_ratio))
    val_idx = idx[:n_val]
    trn_idx = idx[n_val:]
    X_train = [image_paths[i] for i in trn_idx]
    y_train = [mask_paths[i]  for i in trn_idx]
    X_val   = [image_paths[i] for i in val_idx]
    y_val   = [mask_paths[i]  for i in val_idx]
    return X_train, X_val, y_train, y_val


# --- Normalization helper ---
def Norm(c, g=8):
    g = min(g, c) if c % g == 0 else 1  # fallback if c not divisible by g
    return nn.GroupNorm(g, c)

# --- Residual Conv Block ---
class ResConvBlock(nn.Module):
    def __init__(self, in_ch, out_ch, dropout=0.0):
        super().__init__()
        self.proj = nn.Identity() if in_ch == out_ch else nn.Conv2d(in_ch, out_ch, 1)
        self.block = nn.Sequential(
            Norm(in_ch), nn.ReLU(inplace=True),
            nn.Conv2d(in_ch, out_ch, 3, padding=1),
            Norm(out_ch), nn.ReLU(inplace=True),
            nn.Conv2d(out_ch, out_ch, 3, padding=1),
            nn.Dropout2d(dropout) if dropout > 0 else nn.Identity(),
        )

    def forward(self, x):
        return self.proj(x) + self.block(x)

# --- scSE attention ---
class scSE(nn.Module):
    def __init__(self, ch, r=16):
        super().__init__()
        self.cSE = nn.Sequential(
            nn.AdaptiveAvgPool2d(1),
            nn.Conv2d(ch, ch//r, 1), nn.ReLU(inplace=True),
            nn.Conv2d(ch//r, ch, 1), nn.Sigmoid()
        )
        self.sSE = nn.Sequential(nn.Conv2d(ch, 1, 1), nn.Sigmoid())
    def forward(self, x):
        return x * self.cSE(x) + x * self.sSE(x)

# --- Attention Gate ---
class AttentionGate(nn.Module):
    def __init__(self, F_g, F_l, F_int):
        super().__init__()
        self.W_g = nn.Conv2d(F_g, F_int, 1)
        self.W_x = nn.Conv2d(F_l, F_int, 1)
        self.psi  = nn.Sequential(nn.ReLU(inplace=True), nn.Conv2d(F_int, 1, 1), nn.Sigmoid())
    def forward(self, g, x):
        att = self.psi(self.W_g(g) + self.W_x(x))
        return x * att

# --- Up-sample ---
class Up(nn.Module):
    def __init__(self, in_ch, out_ch):
        super().__init__()
        self.conv = nn.Conv2d(in_ch, out_ch, 3, padding=1)
    def forward(self, x):
        x = F.interpolate(x, scale_factor=2, mode='bilinear', align_corners=False)
        return self.conv(x)

# --- Custom AttRes U-Net ---
class MetalUNet_AttRes(nn.Module):
    def __init__(self, in_channels=1, out_channels=1, base=64, dropout=0.1, use_scse=True):
        super().__init__()
        # Encoder
        self.enc1 = ResConvBlock(in_channels, base)
        self.enc2 = ResConvBlock(base, base*2)
        self.enc3 = ResConvBlock(base*2, base*4)
        self.enc4 = ResConvBlock(base*4, base*8)
        self.pool = nn.MaxPool2d(2)

        # Bottleneck
        self.bottleneck = ResConvBlock(base*8, base*16, dropout=dropout)

        # Decoder
        self.up4 = Up(base*16, base*8); self.att4 = AttentionGate(base*8, base*8, base*4)
        self.dec4 = ResConvBlock(base*16, base*8, dropout=dropout); self.scse4 = scSE(base*8) if use_scse else nn.Identity()

        self.up3 = Up(base*8, base*4); self.att3 = AttentionGate(base*4, base*4, base*2)
        self.dec3 = ResConvBlock(base*8, base*4, dropout=dropout); self.scse3 = scSE(base*4) if use_scse else nn.Identity()

        self.up2 = Up(base*4, base*2); self.att2 = AttentionGate(base*2, base*2, base)
        self.dec2 = ResConvBlock(base*4, base*2, dropout=dropout); self.scse2 = scSE(base*2) if use_scse else nn.Identity()

        self.up1 = Up(base*2, base); self.att1 = AttentionGate(base, base, base//2)
        self.dec1 = ResConvBlock(base*2, base, dropout=dropout); self.scse1 = scSE(base) if use_scse else nn.Identity()

        self.final = nn.Conv2d(base, out_channels, 1)

    def forward(self, x):
        e1 = self.enc1(x)
        e2 = self.enc2(self.pool(e1))
        e3 = self.enc3(self.pool(e2))
        e4 = self.enc4(self.pool(e3))

        b  = self.bottleneck(self.pool(e4))

        d4 = self.up4(b);  d4 = torch.cat([self.att4(d4, e4), d4], dim=1); d4 = self.scse4(self.dec4(d4))
        d3 = self.up3(d4); d3 = torch.cat([self.att3(d3, e3), d3], dim=1); d3 = self.scse3(self.dec3(d3))
        d2 = self.up2(d3); d2 = torch.cat([self.att2(d2, e2), d2], dim=1); d2 = self.scse2(self.dec2(d2))
        d1 = self.up1(d2); d1 = torch.cat([self.att1(d1, e1), d1], dim=1); d1 = self.scse1(self.dec1(d1))

        return self.final(d1)    # logits

# --- SMP U-Net++ wrapper ---
class MetalUNetPP(nn.Module):
    def __init__(
        self,
        encoder_name: str = 'timm-efficientnet-b4',
        encoder_weights: Optional[str] = 'imagenet',
        in_channels: int = 1,
        classes: int = 1,
        decoder_channels=(256, 128, 64, 32, 16),
        decoder_attention_type=None,
    ):
        super().__init__()
        if not _HAS_SMP:
            raise ImportError(
                "segmentation-models-pytorch is required for MetalUNetPP. "
                "Install with: pip install -U segmentation-models-pytorch timm"
            )
        self.net = smp.UnetPlusPlus(
            encoder_name=encoder_name,
            encoder_weights=encoder_weights,
            in_channels=in_channels,
            classes=classes,
            decoder_channels=decoder_channels,
            decoder_attention_type=decoder_attention_type,
            activation=None
        )

    def forward(self, x):
        return self.net(x)


def build_unetpp_preset(preset: str = "effb4",
                        in_channels: int = 1,
                        classes: int = 1) -> nn.Module:
    preset = preset.lower()
    if preset == "effb4":
        return MetalUNetPP(
            encoder_name='timm-efficientnet-b4',
            encoder_weights='imagenet',
            in_channels=in_channels, classes=classes,
            decoder_channels=(256, 128, 64, 32, 16),
            decoder_attention_type=None
        )
    elif preset == "effb7":
        return MetalUNetPP(
            encoder_name='timm-efficientnet-b7',
            encoder_weights='imagenet',
            in_channels=in_channels, classes=classes,
            decoder_channels=(192, 96, 48, 24, 12),
            decoder_attention_type=None
        )
    elif preset == "resnet50":
        return MetalUNetPP(
            encoder_name='resnet50',
            encoder_weights='imagenet',
            in_channels=in_channels, classes=classes,
            decoder_channels=(256, 128, 64, 32, 16),
            decoder_attention_type='scse'
        )
    elif preset == "convnext_base":
        return MetalUNetPP(
            encoder_name='timm-convnext_base',
            encoder_weights='imagenet',
            in_channels=in_channels, classes=classes,
            decoder_channels=(256, 128, 64, 32, 16),
            decoder_attention_type=None
        )
    else:
        raise ValueError(f"Unknown preset '{preset}'. Choose from: effb4, effb7, resnet50, convnext_base.")


class FocalDiceLoss(nn.Module):
    """
    Numerically-stable Focal + Soft Dice on logits.
    """
    def __init__(self, alpha=0.8, gamma=2.0, smooth=1e-6):
        super().__init__()
        self.alpha = alpha
        self.gamma = gamma
        self.smooth = smooth
        self.bce_logits = nn.BCEWithLogitsLoss(reduction='none')

    def forward(self, logits, targets):
        targets = targets.float()
        bce = self.bce_logits(logits, targets)              # (B,1,H,W)
        probs = torch.sigmoid(logits)
        p_t = targets * probs + (1 - targets) * (1 - probs)
        focal_weight = self.alpha * (1 - p_t).clamp(min=1e-6).pow(self.gamma)
        focal = (focal_weight * bce).mean()

        # Soft dice
        intersection = (probs * targets).sum(dim=(1, 2, 3))
        denom = probs.sum(dim=(1, 2, 3)) + targets.sum(dim=(1, 2, 3))
        dice = (2 * intersection + self.smooth) / (denom + self.smooth)
        dice_loss = 1 - dice.mean()

        return focal + dice_loss


def iou_from_logits(logits: torch.Tensor, targets: torch.Tensor,
                    threshold: float = 0.5, eps: float = 1e-6) -> torch.Tensor:
    probs = torch.sigmoid(logits)
    preds = (probs > threshold).float()
    targets = targets.float()
    dims = tuple(range(2, preds.ndim))
    intersection = (preds * targets).sum(dims)
    union = preds.sum(dims) + targets.sum(dims) - intersection
    iou = (intersection + eps) / (union + eps)
    return iou.mean()


