def aa_resize(pil_img: Image.Image, size_hw: Tuple[int,int]) -> Image.Image:
    """Anti-aliased resize: LANCZOS when shrinking, BICUBIC when enlarging."""
    W, H = size_hw
    w0, h0 = pil_img.size
    resample = _LANCZOS if (W < w0 or H < h0) else _BICUBIC
    return pil_img.resize((W, H), resample=resample)

# -------------------- Augment (thin-line friendly) --------------------
class ThinLineTransform:
    """
    Mild SEM-friendly augmentations w/ scale jitter (±8–12%) + AA resize.
    """
    def __init__(self, img_size=256):
        self.img_size = img_size

    @staticmethod
    def _to_pil(x):
        x = np.asarray(x).astype(np.float32)
        if x.ndim == 3 and x.shape[2] == 1:
            x = x[...,0]
        x8 = (np.clip(x,0,1)*255).astype(np.uint8)
        return Image.fromarray(x8, mode='L')

    def __call__(self, img_np, mask_np):
        img = img_np[...,0]
        msk = (mask_np[...,0] > 0.5).astype(np.float32)
        I = self._to_pil(img)
        M = self._to_pil(msk)

        # flips
        if random.random() < 0.5:
            I = I.transpose(Image.FLIP_LEFT_RIGHT)
            M = M.transpose(Image.FLIP_LEFT_RIGHT)
        if random.random() < 0.5:
            I = I.transpose(Image.FLIP_TOP_BOTTOM)
            M = M.transpose(Image.FLIP_TOP_BOTTOM)

        # tiny affine
        if random.random() < 0.2:
            deg = random.uniform(-3.0, 3.0)
            tx  = random.uniform(-0.02, 0.02)
            ty  = random.uniform(-0.02, 0.02)
            shx = random.uniform(-2.0, 2.0)
            shy = random.uniform(-2.0, 2.0)
            iw, ih = I.size
            I = TF.affine(I, angle=deg, translate=(int(tx*iw), int(ty*ih)),
                          scale=1.0, shear=(shx,shy), interpolation=TF.InterpolationMode.BILINEAR)
            M = TF.affine(M, angle=deg, translate=(int(tx*iw), int(ty*ih)),
                          scale=1.0, shear=(shx,shy), interpolation=TF.InterpolationMode.NEAREST)

        # scale jitter ±8–12% (AA)
        s = random.uniform(0.92, 1.12)
        new_w = max(1, int(I.size[0]*s)); new_h = max(1, int(I.size[1]*s))
        I = aa_resize(I, (new_w, new_h))
        M = M.resize((new_w, new_h), resample=_NEAREST)

        # final AA resize to net input
        I = aa_resize(I, (self.img_size, self.img_size))
        M = M.resize((self.img_size, self.img_size), resample=_NEAREST)

        # light photometric
        if random.random() < 0.2:
            I = ImageEnhance.Brightness(I).enhance(random.uniform(0.9, 1.1))
        if random.random() < 0.2:
            I = ImageEnhance.Contrast(I).enhance(random.uniform(0.9, 1.1))
        if random.random() < 0.1:
            arr = np.array(I, dtype=np.float32)/255.0
            arr = np.power(arr, random.uniform(0.9,1.1))
            I = Image.fromarray((np.clip(arr,0,1)*255).astype(np.uint8), mode='L')
        if random.random() < 0.1:
            I = I.filter(ImageFilter.GaussianBlur(radius=random.uniform(0.3, 0.8)))

        img_t  = TF.to_tensor(I)                  # (1,H,W)
        mask_t = (TF.to_tensor(M) > 0.5).float()  # (1,H,W)
        return img_t, mask_t

# -------------------- Dataset (with pre_upscale) --------------------
class ViaDataset(Dataset):
    def __init__(self, image_paths: List[str], mask_paths: List[str],
                 img_size: int = 256, augment: bool = False, pre_upscale: float = 1.0):
        assert len(image_paths) == len(mask_paths), "Image/Mask count mismatch"
        self.image_paths = image_paths
        self.mask_paths = mask_paths
        self.img_size = img_size
        self.augment = augment
        self.pre_upscale = pre_upscale
        self.custom_transform = ThinLineTransform(img_size) if augment else None

    def __len__(self):
        return len(self.image_paths)

    def __getitem__(self, idx: int):
        img = Image.open(self.image_paths[idx]).convert('L')
        msk = Image.open(self.mask_paths[idx]).convert('L')

        # pre-upscale only for non-aug (val/test)
        if not self.augment and self.pre_upscale != 1.0:
            new_w = max(1, int(img.size[0] * self.pre_upscale))
            new_h = max(1, int(img.size[1] * self.pre_upscale))
            img = aa_resize(img, (new_w, new_h))          # BICUBIC when enlarging
            msk = msk.resize((new_w, new_h), resample=_NEAREST)

        # final AA resize to model input
        img = aa_resize(img, (self.img_size, self.img_size))
        msk = msk.resize((self.img_size, self.img_size), resample=_NEAREST)

        img_np = (np.array(img, dtype=np.float32)/255.0)[...,None]
        msk_np = ((np.array(msk, dtype=np.float32)/255.0) > 0.5).astype(np.float32)[...,None]

        if self.augment and self.custom_transform is not None:
            return self.custom_transform(img_np, msk_np)
        else:
            img_t  = torch.tensor(img_np, dtype=torch.float32).permute(2,0,1)
            msk_t  = torch.tensor(msk_np, dtype=torch.float32).permute(2,0,1)
            return img_t, msk_t

