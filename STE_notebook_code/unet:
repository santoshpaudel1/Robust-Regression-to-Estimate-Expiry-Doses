def train_one_epoch(model, loader, device, criterion, optimizer, scaler,
                    mixed_precision=True, train_iou_threshold=0.7, use_cuda=True):
    model.train()
    running_loss = 0.0
    running_iou  = 0.0

    for i, (images, masks) in enumerate(loader):
        images = images.to(device, non_blocking=True)
        masks  = masks.to(device,  non_blocking=True)
        optimizer.zero_grad(set_to_none=True)

        with autocast_ctx(mixed_precision):
            outputs = model(images)  # logits
            loss    = criterion(outputs, masks)

        scaler.scale(loss).backward()

        # Optional gradient clipping:
        # scaler.unscale_(optimizer)
        # torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)

        scaler.step(optimizer)
        scaler.update()

        with torch.no_grad():
            running_loss += loss.item() * images.size(0)
            running_iou  += iou_from_logits(outputs, masks, threshold=train_iou_threshold).item() * images.size(0)

        if use_cuda and (i % 5 == 0):
            clear_memory()

    n = len(loader.dataset)
    return running_loss / n, running_iou / n


@torch.no_grad()
def validate(model, loader, device, criterion, mixed_precision=True, val_iou_threshold=0.5):
    model.eval()
    running_loss = 0.0
    running_iou  = 0.0

    for images, masks in loader:
        images = images.to(device, non_blocking=True)
        masks  = masks.to(device, non_blocking=True)

        with autocast_ctx(mixed_precision):
            outputs = model(images)
            loss    = criterion(outputs, masks)

        running_loss += loss.item() * images.size(0)
        running_iou  += iou_from_logits(outputs, masks, threshold=val_iou_threshold).item() * images.size(0)

    n = len(loader.dataset)
    return running_loss / n, running_iou / n


