def total_loss_fn(logits, targets):
    # compute loss in float32 (outside autocast) for stability
    with torch.cuda.amp.autocast(enabled=False):
        l_comp = composite(logits.float(), targets.float())
        if use_edge_blend:
            l_edge = edge_loss(logits.float(), targets.float())
            return 0.8 * l_comp + 0.2 * l_edge
        else:
            return l_comp


