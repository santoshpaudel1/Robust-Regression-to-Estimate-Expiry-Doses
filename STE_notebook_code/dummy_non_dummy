def fast_hole_detection(mask):
    """Detect holes using border flood-fill (10-100x faster than contour method)."""
    # Add 1px border to prevent edge leaks
    padded = np.pad(mask, 1, mode='constant', constant_values=0)
    h, w = padded.shape
    
    # Create mask for flood fill (needs 2px border for OpenCV)
    flood_mask = np.zeros((h+2, w+2), np.uint8)
    
    # Flood fill from all four corners
    cv2.floodFill(padded, flood_mask, (0,0), 255)
    cv2.floodFill(padded, flood_mask, (w-1,0), 255)
    cv2.floodFill(padded, flood_mask, (0,h-1), 255)
    cv2.floodFill(padded, flood_mask, (w-1,h-1), 255)
    
    # Remove padding and compare with original
    result = padded[1:-1, 1:-1]
    return np.any(result != mask)

def calculate_features(mask):
    """Optimized feature extraction with fast hole detection."""
    # Hole detection (fast flood-fill method)
    has_holes = fast_hole_detection(mask)
    
    # Skeleton analysis (reuse for junctions)
    skeleton = skeletonize(mask // 255).astype(np.uint8)
    
    # Junction detection using convolution
    kernel = np.array([[1,1,1], [1,0,1], [1,1,1]], dtype=np.uint8)
    neighbor_count = cv2.filter2D(skeleton, cv2.CV_8U, kernel)
    junctions = np.count_nonzero(neighbor_count >= 3)
    
    # Aspect ratio calculation
    y, x = np.where(mask)
    if len(y) == 0:
        return has_holes, 0, 0
    length = max(y.max()-y.min(), x.max()-x.min())
    width = min(y.max()-y.min(), x.max()-x.min())
    aspect_ratio = length / width if width > 0 else 0
    
    return has_holes, junctions, aspect_ratio

def classify_component(args):
    """Classification with optimized hole detection."""
    mask, bbox = args
    has_holes, junctions, aspect_ratio = calculate_features(mask)
    
    # Closed structures are always complex
    if has_holes:
        return ('complex', mask, bbox)
    
    # Simple structure criteria
    is_simple = (
        junctions <= 2 and      # Few branch points
        aspect_ratio > 4        # Long and narrow
    )
    
    return ('simple', mask, bbox) if is_simple else ('complex', mask, bbox)

