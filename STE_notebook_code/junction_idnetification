def getConnectedComponents_skeleton_sparse(binary_image):
    """
    Get all connected components in the image, sorted by size, and classify them.
    
    Parameters:
    image (numpy.ndarray): Input image.
    
    Returns:
    tuple: Two lists containing straight lines and grid-like structures.
    """
    
    # Skeletonize the image
    skeleton = skeletonize(binary_image)
    
    # Get connected components
    labels = label(skeleton)
    component_sizes = np.bincount(labels.ravel())
    sorted_components = np.argsort(component_sizes)[::-1]  # Sort components from largest to smallest
    sorted_components = sorted_components[sorted_components != 0]  # Exclude background label (0)
    
    straight_lines = []
    grid_like_structures = []
    
    for i, component in enumerate(sorted_components):
        mask = labels == component
        if np.any(mask):
            # Convert mask to a sparse matrix
            sparse_mask = csr_matrix(mask)
            mask = sparse_mask.toarray()
            
            # Calculate statistics for the component
            x, y, w, h = cv2.boundingRect(mask.astype(np.uint8))
            area = np.sum(mask)
            
            # Count the number of junctions in the component
            num_junctions = count_junctions(mask.astype(np.uint8))
            
            # Criteria for classification based on number of junctions
            if num_junctions >= 30:
                grid_like_structures.append(mask)
                # print(f"Grid-like Structure {len(grid_like_structures)}:")
            else:
                straight_lines.append(mask)
            #     print(f"Straight Line {len(straight_lines)}:")
            
            # print(f"  Bounding Box: x={x}, y={y}, width={w}, height={h}")
            # print(f"  Area: {area}")
            # print(f"  Number of Junctions: {num_junctions}")
            
            # Explicitly call garbage collector
            gc.collect()
    
    return straight_lines, grid_like_structures
	
	
def count_junctions(component):
    """
    Count the number of junctions in a skeletonized component.
    
    Parameters:
    component (numpy.ndarray): Binary image of the component.
    
    Returns:
    int: Number of junctions in the component.
    """
    
    # Define a kernel to detect junctions
    
    kernel = np.array([[1, 1, 1],
                       [1, 10, 1],
                       [1, 1, 1]], dtype=np.uint8)

    convolved = cv2.filter2D(component, -1, kernel)
    
    # Count the number of junctions (pixels with value greater than 12)
    junctions = np.sum(convolved >= 13)
    
    return junctions
	
def remove_edge_effect(image):
    """
    Remove edge effect in segmentation by setting the edges of the image to zero.
    
    Parameters:
    image (numpy.ndarray): Input binary image.
    
    Returns:
    numpy.ndarray: Image with edge effect removed.
    """
    # Create a mask with edges set to zero
    mask = np.ones_like(image)
    mask[0, :] = 0
    mask[-1, :] = 0
    mask[:, 0] = 0
    mask[:, -1] = 0
    
    # Apply the mask to the image
    image = image * mask
    
    return image
	
