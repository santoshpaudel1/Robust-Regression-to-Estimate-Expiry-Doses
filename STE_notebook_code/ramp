# ========== 1) Workweek → absolute index (robust) ==========
def ww_to_abs_index(ww):
    """
    Convert Workweek label to an absolute, monotonically increasing index using ISO weeks.
    Accepts common formats:
      - 'YYYYWW'        (e.g., '202550')
      - 'YYYY-WW'       (e.g., '2025-50')
      - strings containing 'YYYY' and 'WW' anywhere (we extract first match)
      - integer/float that represent YYYYWW (e.g., 202550)

    Returns: integer index (ISO week anchor converted to ordinal weeks)
    """
    if ww is None:
        return np.nan

    # Normalize to string
    if isinstance(ww, (int, float, np.integer, np.floating)):
        s = str(int(ww))
