# Example usage (you can adapt this in your main script)
# -------------------------------------------------------------------
if __name__ == "__main__":
    # df should be a dataframe with:
    # Design_ID, Fab, WaferGrade, DieGrade, WeekIndex, Yield, Volume
    # Here we assume you've already loaded it as `df`.
    # df = etl_traindata(...)

    # 1. Train logistic profiles
    base_profiles, weighted_profiles = train_ramp_profiles(df)

    # 2. Train ML models
    ml_models = train_ml_models(df)

    # 3. Compare for a particular design + grade combo
    target_design = "D12345"
    target_fab = "FAB1"
    target_wg = "WG1"
    target_dg = "DG1"

    result_df, metrics = compare_models_for_design(
        df,
        base_profiles,
        weighted_profiles,
        ml_models,
        design_id=target_design,
        fab=target_fab,
        wafer_grade=target_wg,
        die_grade=target_dg,
    )

    print("Metrics for design", target_design, ":", metrics)
    print(result_df.head())
