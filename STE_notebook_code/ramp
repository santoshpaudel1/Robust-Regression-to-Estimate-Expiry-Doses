# ========== 2) Yield scaling helper ==========
def _yield_to_unit_interval(y):
    """
    Ensure yield is in [0,1]. If data looks like percentages (max > 1.5), convert by /100.
    Clips to (eps, 1-eps) to avoid boundary issues.
    """
    y = np.asarray(y, dtype=float)
    if np.nanmax(y) > 1.5:   # likely percentage
        y = y / 100.0
    eps = 1e-6
    return np.clip(y, eps, 1.0 - eps)


