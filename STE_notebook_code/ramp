def etl_traindata(sql_query, datatype):
    """
    Extract, transform, and load training data from BigQuery (no volume weighting).
    Outputs aligned columns: ['Design_ID','Fab','WaferGrade','DieGrade'(dg only),
                              'Workweek','Yield','WeekIndex','abs_idx']
    """
    if datatype not in ('dg', 'wg'):
        raise ValueError("datatype must be 'dg' or 'wg'")

