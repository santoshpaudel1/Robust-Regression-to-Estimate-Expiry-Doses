# Create a weight matrix for blending
def create_weight_matrix(patch_height, patch_width):
    y = np.linspace(-1, 1, patch_height)
    x = np.linspace(-1, 1, patch_width)
    xv, yv = np.meshgrid(x, y)
    weight_matrix = np.exp(-(xv**2 + yv**2))
    return weight_matrix

# Function to predict mask for a patch using CPU
def predict_patch(patch, model, input_size, device):
    patch = cv2.resize(patch, input_size)
    patch = np.expand_dims(patch, axis=0)  # Add batch dimension
    patch_tensor = torch.tensor(patch).unsqueeze(1).float().to(device)  # Convert to PyTorch tensor and move to device
    with torch.no_grad():
        output = model(patch_tensor)
        predicted_patch_mask = torch.sigmoid(output).cpu().numpy()
        predicted_patch_mask = (predicted_patch_mask > 0.5).astype(np.uint8)  # Binarize the output
        predicted_patch_mask = np.squeeze(predicted_patch_mask)  # Remove batch dimension
    return predicted_patch_mask

def process_large_image_full_coverage(large_image, model, device, patch_height=256, patch_width=256, stride=128):
    if large_image is None:
        raise FileNotFoundError("Image not found")
    
    large_image = large_image / 255.0
    original_height, original_width = large_image.shape[:2]  # Save the original size

    # Initialize an empty mask for the large image
    large_mask = np.zeros((original_height, original_width))
    weight_matrix = np.zeros((original_height, original_width))
    weight_matrix_patch = create_weight_matrix(patch_height, patch_width)

    # Slide the window over the large image and predict masks using CPU
    for y in range(0, original_height, stride):
        for x in range(0, original_width, stride):
            patch = large_image[y:y + patch_height, x:x + patch_width]
            if patch.shape[0] != patch_height or patch.shape[1] != patch_width:
                # If the patch is smaller than the desired size (i.e., at the edges), pad it with zeros
                padded_patch = np.zeros((patch_height, patch_width))
                padded_patch[:patch.shape[0], :patch.shape[1]] = patch
                patch = padded_patch

            predicted_patch_mask = predict_patch(patch, model, (patch_height, patch_width), device)
            
            # Update the mask and weight matrix using the weight matrix patch
            mask_update_height = min(patch_height, original_height - y)
            mask_update_width = min(patch_width, original_width - x)
            large_mask[y:y + mask_update_height, x:x + mask_update_width] += predicted_patch_mask[:mask_update_height, :mask_update_width] * weight_matrix_patch[:mask_update_height, :mask_update_width]
            weight_matrix[y:y + mask_update_height, x:x + mask_update_width] += weight_matrix_patch[:mask_update_height, :mask_update_width]

    # Normalize the mask by the weight matrix to blend the overlapping regions
    epsilon = 1e-8  # Small value to avoid division by zero
    large_mask_vias = large_mask / (weight_matrix + epsilon)
    
    return large_mask_vias


