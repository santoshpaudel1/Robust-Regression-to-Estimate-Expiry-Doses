def create_composite_image(components, image_shape):
    """Create a composite image from list of components."""
    composite_image = np.zeros(image_shape, dtype=np.uint8)
    
    for mask, bbox in components:
        x1, y1, x2, y2 = bbox
        composite_image[y1:y2, x1:x2] = mask
    
    return composite_image

