def count_junctions(component_mask):
    skeleton = skeletonize(component_mask).astype(np.uint8)
    y_coords, x_coords = np.where(skeleton)
    coords_set = set(zip(y_coords, x_coords))
    junction_count = 0
    for y, x in zip(y_coords, x_coords):
        count = 0
        for dy in [-1, 0, 1]:
            for dx in [-1, 0, 1]:
                if dy == 0 and dx == 0:
                    continue
                if (y + dy, x + dx) in coords_set:
                    count += 1
        if count >=4:
            junction_count += 1
    return junction_count




def get_connected_components(segmented_image):
    # Apply morphological opening to remove small connections
    kernel = np.ones((3, 3), np.uint8)
    opened_image = cv2.morphologyEx(segmented_image, cv2.MORPH_OPEN, kernel)
    
    labels = label(opened_image)
    components = []
    for component in np.unique(labels):
        if component == 0:
            continue
        coords = np.argwhere(labels == component)
        if len(coords) == 0:
            continue
        y_min, y_max = coords[:, 0].min(), coords[:, 0].max()
        x_min, x_max = coords[:, 1].min(), coords[:, 1].max()
        sub_labels = labels[y_min:y_max+1, x_min:x_max+1]
        component_mask = (sub_labels == component).astype(np.uint8)
        components.append((component_mask, x_min, y_min, x_max, y_max))
    return components

