def add_coordinates(df, x_offset, y_offset):
    """
    Add x and y coordinates to the start and end points of the lines in the DataFrame.
    
    Parameters:
    df (pd.DataFrame): DataFrame containing lines with columns ['start', 'end'].
    x_offset (int): Offset to be added to the x coordinate.
    y_offset (int): Offset to be added to the y coordinate.
    
    Returns:
    pd.DataFrame: DataFrame with updated coordinates.
    """
    df['start'] = df['start'].apply(lambda coord: (coord[0] + x_offset, coord[1] + y_offset))
    df['end'] = df['end'].apply(lambda coord: (coord[0] + x_offset, coord[1] + y_offset))
    return df



