def process_combined_lines(df_split_horizontal_at_vias, df_split_vertical_at_vias):
    """
    Merge both DataFrames into a single DataFrame, drop lines where x1=x2 and y1=y2, assign unique IDs to each line,
    convert to the specified format, select the required columns, and display the final DataFrame.
    
    Parameters:
    df_split_horizontal_at_vias (pd.DataFrame): DataFrame containing split horizontal lines.
    df_split_vertical_at_vias (pd.DataFrame): DataFrame containing split vertical lines.
    
    Returns:
    pd.DataFrame: Processed DataFrame with combined lines.
    """
    # Merge both DataFrames into a single DataFrame
    df_combined_lines_M1_splited = pd.concat([df_split_horizontal_at_vias, df_split_vertical_at_vias], ignore_index=True)

    # Drop lines where x1=x2 and y1=y2
    df_combined_lines_M1_splited = df_combined_lines_M1_splited[~((df_combined_lines_M1_splited['x1'] == df_combined_lines_M1_splited['x2']) & (df_combined_lines_M1_splited['y1'] == df_combined_lines_M1_splited['y2']))]

    # Assign unique IDs to each line
    df_combined_lines_M1_splited = df_combined_lines_M1_splited.assign(ID=range(1, len(df_combined_lines_M1_splited) + 1))

    # Convert to the specified format
    df_combined_lines_M1_splited['start'] = list(zip(df_combined_lines_M1_splited['x1'], df_combined_lines_M1_splited['y1']))
    df_combined_lines_M1_splited['end'] = list(zip(df_combined_lines_M1_splited['x2'], df_combined_lines_M1_splited['y2']))

    # Select the required columns
    df_combined_lines_M1_splited = df_combined_lines_M1_splited[['ID', 'start', 'end']]
    return df_combined_lines_M1_splited



