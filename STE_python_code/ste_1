        # Bottleneck
        b = self.bottleneck(self.pool(e4))
        
        # Decoder with attention
        d4 = self.up4(b)
        a4 = self.att4(d4, e4)
        d4 = torch.cat((a4, d4), dim=1)
        d4 = self.dec4(d4)
        
        d3 = self.up3(d4)
        a3 = self.att3(d3, e3)
        d3 = torch.cat((a3, d3), dim=1)
        d3 = self.dec3(d3)
        
        d2 = self.up2(d3)
        a2 = self.att2(d2, e2)
        d2 = torch.cat((a2, d2), dim=1)
        d2 = self.dec2(d2)
        
        d1 = self.up1(d2)
        a1 = self.att1(d1, e1)
        d1 = torch.cat((a1, d1), dim=1)
        d1 = self.dec1(d1)
        
        return self.final(d1)

# 3. Advanced Loss Function ----------------------------------------------------
class FocalDiceLoss(nn.Module):
    """Combines Dice loss for segmentation with Focal loss for class imbalance"""
    def __init__(self, gamma=2.0, alpha=0.8, smooth=1e-6):
        super().__init__()
        self.gamma = gamma
        self.alpha = alpha
        self.smooth = smooth
        
    def forward(self, inputs, targets):
        # Inputs are logits, targets are 0/1 masks
        inputs = torch.sigmoid(inputs)
        
        # Flatten tensors
        inputs = inputs.view(-1)
        targets = targets.view(-1)
        
        # Focal loss component
        BCE = F.binary_cross_entropy(inputs, targets, reduction='mean')
        BCE_EXP = torch.exp(-BCE)
        focal_loss = self.alpha * (1 - BCE_EXP)**self.gamma * BCE
        
        # Dice loss component
        intersection = (inputs * targets).sum()
        dice = (2. * intersection + self.smooth) / (inputs.sum() + targets.sum() + self.smooth)
        dice_loss = 1 - dice
        
        # Combine losses
        return focal_loss + dice_loss

# 4. Model Initialization ------------------------------------------------------
model = ViaDetector(in_channels=1).to(device)
print(f"Model parameters: {sum(p.numel() for p in model.parameters())/1e6:.2f}M")

# Loss and optimizer
criterion = FocalDiceLoss()
optimizer = optim.AdamW(model.parameters(), lr=LEARNING_RATE, weight_decay=1e-5)
scheduler = optim.lr_scheduler.ReduceLROnPlateau(optimizer, mode='min', factor=0.5, patience=5)

# Mixed precision scaler
scaler = amp.GradScaler(enabled=MIXED_PRECISION)

# 5. Enhanced Training Loop with Metrics ---------------------------------------
def calculate_iou(preds, targets, threshold=0.5):
    """Calculate Intersection over Union (IoU)"""
    preds = (torch.sigmoid(preds) > threshold).float()
    targets = targets.float()
    
    intersection = (preds * targets).sum()
    union = preds.sum() + targets.sum() - intersection
    
    return (intersection + 1e-6) / (union + 1e-6)

def clear_memory():
    torch.cuda.empty_cache()
    gc.collect()

# Training loop
best_val_iou = 0.0

# Training loop
print("Starting training...")
for epoch in range(NUM_EPOCHS):
    # Training phase
    model.train()
    train_loss = 0.0
    train_iou = 0.0
    
    for i, (images, masks) in enumerate(train_loader):
        images, masks = images.to(device), masks.to(device)
        
        optimizer.zero_grad(set_to_none=True)
        
        # Mixed precision context
        with amp.autocast(dtype=torch.float16, enabled=MIXED_PRECISION):
            outputs = model(images)
            loss = criterion(outputs, masks)
        
        # Backpropagation
        scaler.scale(loss).backward()
        scaler.step(optimizer)
        scaler.update()
        
        # Calculate metrics
        train_loss += loss.item() * images.size(0)
        train_iou += calculate_iou(outputs, masks).item() * images.size(0)
        
        # Clean memory every 5 batches
        if i % 5 == 0:
            clear_memory()
    
    # Validation phase
    model.eval()
    val_loss = 0.0
    val_iou = 0.0
    
    with torch.no_grad():
        for images, masks in val_loader:
            images, masks = images.to(device), masks.to(device)
            
            outputs = model(images)
            loss = criterion(outputs, masks)
            
            val_loss += loss.item() * images.size(0)
            val_iou += calculate_iou(outputs, masks).item() * images.size(0)
    
    # Calculate epoch metrics
    train_loss /= len(train_loader.dataset)
    train_iou /= len(train_loader.dataset)
    val_loss /= len(val_loader.dataset)
    val_iou /= len(val_loader.dataset)
    
    # Update scheduler
    scheduler.step(val_loss)
    
