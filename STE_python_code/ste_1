class AdvancedSEMTransform:
    """Advanced transformations for SEM images with synchronized image-mask augmentations"""
    def __init__(self, img_size=256):
        self.img_size = img_size
        
    def __call__(self, img, mask):
        # Convert to PIL
        img = Image.fromarray((img * 255).astype(np.uint8).squeeze())
        mask = Image.fromarray((mask * 255).astype(np.uint8).squeeze())
        
        # Random rotation
        angle = np.random.choice([0, 90, 180, 270])
        img = img.rotate(angle)
        mask = mask.rotate(angle)
        
        # Random flip
        if np.random.rand() > 0.5:
            img = img.transpose(Image.FLIP_LEFT_RIGHT)
            mask = mask.transpose(Image.FLIP_LEFT_RIGHT)
            
        if np.random.rand() > 0.5:
            img = img.transpose(Image.FLIP_TOP_BOTTOM)
            mask = mask.transpose(Image.FLIP_TOP_BOTTOM)
            
        # Random brightness/contrast
        if np.random.rand() > 0.7:
            enhancer = ImageEnhance.Brightness(img)
            img = enhancer.enhance(np.random.uniform(0.8, 1.2))
            
        if np.random.rand() > 0.7:
            enhancer = ImageEnhance.Contrast(img)
            img = enhancer.enhance(np.random.uniform(0.8, 1.2))
        
        # Convert to tensors
        img = transforms.functional.to_tensor(img)
        mask = transforms.functional.to_tensor(mask)
        
        return img, mask

       
  
class ViaDataset(Dataset):
