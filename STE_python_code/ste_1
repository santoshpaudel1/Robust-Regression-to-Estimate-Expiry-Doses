def convert_to_ic_explorer(img_png, xy_png, top_left, bottom_right):
    """
    Convert coordinates from image space to IC Explorer space.
    
    Parameters:
    img_png (numpy.ndarray): The input image.
    xy_png (tuple): The (x, y) coordinates in the image space.
    top_left (tuple): The top-left coordinates in the IC Explorer space.
    bottom_right (tuple): The bottom-right coordinates in the IC Explorer space.
    
    Returns:
    tuple: The (x, y) coordinates in the IC Explorer space.
    """
