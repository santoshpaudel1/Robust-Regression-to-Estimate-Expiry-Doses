def process_image_components_incrementally(straight_img_M1, eps_primary_horizontal, eps_secondary_horizontal, eps_primary_vertical, eps_secondary_vertical):
    vertical_dfs = []
    horizontal_dfs = []

    start_time = time.time()

    # Label connected components
    skeletonized_image_M1 = skeletonize(straight_img_M1)
    labels = label(skeletonized_image_M1)
    unique_labels = np.unique(labels)

    # Process components incrementally
    for component_label in unique_labels:
        if component_label == 0:
            continue  # Skip background

        vertical_df, horizontal_df = process_component(
            labels, component_label, eps_primary_horizontal, eps_secondary_horizontal, eps_primary_vertical, eps_secondary_vertical
        )
        vertical_dfs.append(vertical_df)
        horizontal_dfs.append(horizontal_df)

    # Concatenate all dataframes
    vertical_df_M1 = pd.concat(vertical_dfs, ignore_index=True)
    horizontal_df_M1 = pd.concat(horizontal_dfs, ignore_index=True)

    end_time = time.time()
    total_time = end_time - start_time
    print(f"Total time to run the code: {total_time:.2f} seconds")

    return vertical_df_M1, horizontal_df_M1

