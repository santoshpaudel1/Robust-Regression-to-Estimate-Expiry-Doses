    scale_y = (ic_bottom_right_y - ic_top_left_y) / img_height
    
    # Conversion
    x_ic = x_png * scale_x + ic_top_left_x
    y_ic = y_png * scale_y + ic_top_left_y
    x_ic = round(x_ic)
    y_ic = round(y_ic)
    
    return x_ic, y_ic

